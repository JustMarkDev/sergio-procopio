---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/custom/ContactForm";
import { getEntry } from "astro:content";
import { getImage } from "astro:assets";

// Ritratto della biografia: spezza la testata tutta testo.
const bio = await getEntry("pages", "biografia");

let foto = null;
if (bio?.data.image) {
    const ottimizzata = await getImage({
        src: bio.data.image,
        widths: [480, 720, 960],
        format: "webp",
        quality: 75,
    });
    foto = {
        src: ottimizzata.src,
        srcset: ottimizzata.srcSet.attribute,
        width: bio.data.image.width,
        height: bio.data.image.height,
    };
}
---

<Layout
    title="Contatti | Sergio Procopio"
    description="Richiedi un preventivo o una data per uno spettacolo di Sergio Procopio: teatri, oratori, parrocchie, scuole e associazioni."
>
    <div class="relative overflow-hidden bg-background min-h-screen">
        <div
            class="absolute top-0 left-0 w-full h-[50vh] bg-[radial-gradient(ellipse_at_top,rgba(212,162,76,0.06)_0%,transparent_70%)] pointer-events-none"
        >
        </div>

        <div class="container relative z-10 mx-auto px-4 md:px-8 lg:px-12 pt-32">
            <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
                <div class="lg:col-span-7">
                    <h1
                        class="text-5xl md:text-7xl font-serif font-bold mb-6 tracking-tight"
                    >
                        Organizziamo la <span class="italic text-primary"
                            >vostra serata</span
                        >
                    </h1>
                    <p
                        class="text-xl text-muted-foreground max-w-2xl opacity-80 leading-relaxed"
                    >
                        Ogni spettacolo viene concordato su misura per lo spazio
                        che lo ospita. Scrivete indicando il tipo di ente, il
                        periodo che avete in mente e il pubblico atteso:
                        riceverete una risposta con disponibilità e preventivo.
                    </p>
                </div>

                {
                    foto && (
                        <div class="lg:col-span-5">
                            <div class="relative mx-auto aspect-4/3 max-w-md overflow-hidden rounded-4xl border border-white/10 bg-white/5 lg:ml-auto">
                                <img
                                    src={foto.src}
                                    srcset={foto.srcset}
                                    sizes="(min-width: 1024px) 40vw, 100vw"
                                    alt="Sergio Procopio"
                                    width={foto.width}
                                    height={foto.height}
                                    loading="eager"
                                    decoding="async"
                                    class="absolute inset-0 h-full w-full object-cover object-top"
                                />
                                <div
                                    aria-hidden="true"
                                    class="absolute inset-0 bg-linear-to-t from-black/40 to-transparent"
                                />
                            </div>
                        </div>
                    )
                }
            </div>
        </div>

        <ContactForm client:load />
    </div>
</Layout>
