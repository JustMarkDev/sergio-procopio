---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/custom/ContactForm";
---

<Layout
    title="Contatti | Sergio Procopio"
    description="Richiedi un preventivo o una data per uno spettacolo di Sergio Procopio: teatri, oratori, parrocchie, scuole e associazioni."
>
    <div class="relative overflow-hidden bg-[#0b0a09] min-h-screen">
        <div
            class="absolute top-0 left-0 w-full h-[50vh] bg-[radial-gradient(ellipse_at_top,rgba(212,162,76,0.06)_0%,transparent_70%)] pointer-events-none"
        >
        </div>

        <div class="container relative z-10 mx-auto px-4 md:px-8 lg:px-12 pt-32">
            <div class="max-w-4xl">
                <div class="flex items-center gap-4 mb-8">
                    <span class="h-px w-10 bg-primary/40"></span>
                    <span
                        class="text-sm font-bold uppercase tracking-[0.25em] text-primary"
                    >
                        Richiesta disponibilità
                    </span>
                </div>
                <h1
                    class="text-5xl md:text-7xl font-serif font-bold mb-6 tracking-tight"
                >
                    Organizziamo la <span class="italic text-primary"
                        >vostra serata</span
                    >
                </h1>
                <p
                    class="text-xl text-muted-foreground max-w-2xl opacity-80 leading-relaxed"
                >
                    Ogni spettacolo viene concordato su misura per lo spazio che
                    lo ospita. Scrivete indicando il tipo di ente, il periodo che
                    avete in mente e il pubblico atteso: riceverete una risposta
                    con disponibilità e preventivo.
                </p>
            </div>
        </div>

        <ContactForm client:load />
    </div>
</Layout>
