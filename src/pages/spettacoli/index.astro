---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const spettacoli = (await getCollection("spettacoli")).filter(
    (show) => !show.data.draft,
);
---

<Layout title="Tutti gli Spettacoli | Sergio Procopio">
    <div class="container mx-auto min-h-screen px-4 pb-32 pt-36 md:px-8 lg:px-12">
        <header class="mb-16 grid gap-x-12 gap-y-6 lg:grid-cols-[1fr_24rem] lg:items-end">
            <h1 class="text-[clamp(2.75rem,8vw,7rem)] uppercase leading-[0.92]">L'arte della pantomima</h1>
            <p class="text-lg font-light leading-relaxed text-muted-foreground">
                Ogni spettacolo è un viaggio fatto di emozioni, silenzi ed espressioni che parlano al cuore.
            </p>
        </header>

        <ul class="border-b border-border">
            {
                spettacoli.map((show, index) => (
                    <li class="group relative border-t border-border before:absolute before:inset-y-0 before:-left-4 before:w-[3px] before:scale-y-0 before:bg-primary-hover before:transition-transform before:duration-300 hover:before:scale-y-100">
                        <a
                            href={`/spettacoli/${show.id}`}
                            class="grid grid-cols-[1fr_7.5rem] items-center gap-x-5 py-6 sm:grid-cols-[1fr_14rem] sm:gap-x-10 lg:grid-cols-[1fr_20rem] lg:py-8"
                        >
                            <div class="min-w-0">
                                <p class="text-[11px] font-medium uppercase tracking-[0.2em] text-primary-soft">
                                    {show.data.category}
                                    {show.data.durata && ` · ${show.data.durata}`}
                                </p>
                                <h2 class="mt-3 text-2xl uppercase leading-[1.02] transition-transform duration-300 group-hover:translate-x-3 sm:text-3xl lg:text-5xl">
                                    {show.data.title}
                                </h2>
                                <p class="mt-4 line-clamp-2 max-w-[60ch] font-light leading-relaxed text-muted-foreground max-sm:hidden">
                                    {show.data.description}
                                </p>
                            </div>
                            <div class="aspect-4/3 overflow-hidden bg-secondary">
                                {show.data.image && (
                                    <Image
                                        src={show.data.image}
                                        width={640}
                                        height={480}
                                        widths={[240, 400, 640]}
                                        sizes="(min-width: 1024px) 320px, (min-width: 640px) 224px, 120px"
                                        fit="cover"
                                        format="webp"
                                        quality={75}
                                        alt=""
                                        loading={index < 4 ? "eager" : "lazy"}
                                        decoding="async"
                                        class="h-full w-full object-cover opacity-75 transition-all duration-700 ease-out group-hover:scale-[1.05] group-hover:opacity-100"
                                    />
                                )}
                            </div>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</Layout>
