---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const spettacoli = (await getCollection("spettacoli")).filter(
    (show) => !show.data.draft,
);
---

<Layout title="Tutti gli Spettacoli | Sergio Procopio">
    <div class="container mx-auto min-h-screen px-4 pb-24 pt-36 md:px-8 lg:px-12">
        <header class="mb-16 max-w-4xl">
            <h1 class="text-[clamp(2.75rem,8vw,7rem)] uppercase leading-[0.92]">L'arte della pantomima</h1>
            <p class="mt-6 max-w-2xl text-lg font-light leading-relaxed text-muted-foreground lg:text-xl">
                Ogni spettacolo è un viaggio fatto di emozioni, silenzi ed espressioni che parlano al cuore.
            </p>
        </header>

        <div class="grid grid-cols-1 gap-0.5 md:grid-cols-2 lg:grid-cols-3">
            {
                spettacoli.map((show, index) => (
                    <a
                        href={`/spettacoli/${show.id}`}
                        class="group relative block aspect-4/3 overflow-hidden bg-secondary"
                    >
                        {show.data.image && (
                            <Image
                                src={show.data.image}
                                width={800}
                                height={600}
                                widths={[320, 480, 640, 800, 1200]}
                                sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                                fit="cover"
                                format="webp"
                                quality={75}
                                alt=""
                                loading={index < 2 ? "eager" : "lazy"}
                                fetchpriority={index === 0 ? "high" : undefined}
                                decoding="async"
                                class="absolute inset-0 h-full w-full object-cover transition-transform duration-1000 ease-out group-hover:scale-[1.03]"
                            />
                        )}
                        <div class="absolute inset-0 bg-linear-to-t from-background via-background/75 to-transparent" />
                        <div class="absolute inset-x-0 bottom-0 p-6 md:p-7">
                            <p class="text-[11px] font-medium uppercase tracking-[0.2em] text-primary-soft">
                                {show.data.category}
                                {show.data.durata && ` - ${show.data.durata}`}
                            </p>
                            <h2 class="mt-2 text-2xl uppercase leading-[1.05] transition-colors duration-300 group-hover:text-primary-soft md:text-3xl">
                                {show.data.title}
                            </h2>
                            <p class="mt-3 line-clamp-3 max-w-[44ch] text-sm font-light leading-relaxed text-foreground/80">
                                {show.data.description}
                            </p>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</Layout>
