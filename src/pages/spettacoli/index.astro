---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const spettacoli = await getCollection("spettacoli");
---

<Layout title="Tutti gli Spettacoli | Sergio Procopio">
    <div class="relative overflow-hidden bg-[#09090b]">
        <div
            class="absolute top-0 left-0 w-full h-[50vh] bg-[radial-gradient(ellipse_at_top,rgba(37,99,235,0.05)_0%,transparent_70%)] pointer-events-none"
        >
        </div>

        <div class="container relative z-10 mx-auto px-4 py-32 min-h-screen">
            <div class="text-center mb-24">
                <span
                    class="text-primary font-bold tracking-[0.2em] text-[10px] uppercase mb-4 block"
                    >Il Catalogo Completo</span
                >
                <h1
                    class="text-5xl md:text-7xl font-serif font-bold mb-6 tracking-tight"
                >
                    L'Arte della <span class="italic text-primary"
                        >Pantomima</span
                    >
                </h1>
                <p
                    class="text-xl text-muted-foreground max-w-2xl mx-auto italic opacity-80 leading-relaxed"
                >
                    Ogni spettacolo è un viaggio unico fatto di emozioni, <br
                        class="hidden md:block"
                    /> silenzi ed espressioni che parlano al cuore.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
                {
                    spettacoli.map((show) => (
                        <a
                            href={`/spettacoli/${show.id}`}
                            class="group block relative bg-white/2 border border-white/5 rounded-4xl overflow-hidden hover:bg-white/4 hover:border-primary/30 transition-all duration-500"
                        >
                            <div class="aspect-4/3 w-full bg-zinc-900 relative overflow-hidden">
                                <div class="absolute inset-0 bg-linear-to-t from-[#09090b] via-transparent to-transparent z-10" />
                                <div class="absolute inset-0 flex items-center justify-center p-8">
                                    <span class="text-2xl font-serif font-bold text-white/10 group-hover:text-primary/20 transition-colors duration-500 text-center">
                                        {show.data.title}
                                    </span>
                                </div>
                                <div class="absolute top-6 left-6 z-20">
                                    <span class="py-1 px-3 bg-primary/10 backdrop-blur-md border border-primary/20 rounded-full text-[10px] font-bold text-primary uppercase tracking-wider">
                                        {show.data.category}
                                    </span>
                                </div>
                            </div>

                            <div class="p-8 relative z-20">
                                <div class="flex items-center justify-between mb-4">
                                    <h2 class="text-2xl font-bold font-serif group-hover:text-primary transition-colors duration-300">
                                        {show.data.title}
                                    </h2>
                                    {show.data.duration && (
                                        <span class="text-[10px] font-bold opacity-40 uppercase tracking-widest">
                                            {show.data.duration}
                                        </span>
                                    )}
                                </div>
                                <p class="text-muted-foreground text-sm leading-relaxed mb-8 line-clamp-2 opacity-70">
                                    {show.data.description}
                                </p>
                                <div class="inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-primary group/link">
                                    Scopri lo spettacolo
                                    <span class="w-6 h-px bg-primary group-hover/link:w-10 transition-all duration-300" />
                                </div>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</Layout>
