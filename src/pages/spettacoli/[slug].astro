---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const spettacoli = await getCollection("spettacoli");
    return spettacoli.map((show) => ({
        params: { slug: show.id },
        props: { show },
    }));
}

const { show } = Astro.props;
const { Content } = await render(show);
---

<Layout
    title={`${show.data.title} | Sergio Procopio`}
    description={show.data.description}
>
    <article class="container mx-auto px-4 py-24 min-h-screen max-w-4xl">
        <div class="mb-12">
            <a
                href="/spettacoli"
                class="text-primary hover:underline mb-8 inline-block"
                >← Torna a tutti gli spettacoli</a
            >
            <div class="flex flex-wrap items-center gap-4 mb-4">
                <span
                    class="px-3 py-1 bg-primary/10 text-primary rounded-full text-sm font-medium"
                    >{show.data.category}</span
                >
                {
                    show.data.duration && (
                        <span class="text-sm text-muted-foreground">
                            ⏱️ {show.data.duration}
                        </span>
                    )
                }
                {
                    show.data.etaConsigliata && (
                        <span class="text-sm text-muted-foreground">
                            👥 {show.data.etaConsigliata}
                        </span>
                    )
                }
            </div>
            <h1 class="text-5xl md:text-6xl font-serif font-bold mb-6">
                {show.data.title}
            </h1>
            <p class="text-xl text-muted-foreground italic">
                {show.data.description}
            </p>
        </div>

        {/* Technical Details Grid */}
        {
            (show.data.regia ||
                show.data.produzione ||
                show.data.tecnico ||
                show.data.costo) && (
                <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12 p-6 bg-secondary/20 rounded-xl border border-border">
                    {show.data.regia && (
                        <div>
                            <div class="text-xs text-muted-foreground uppercase tracking-wider mb-1">
                                Regia
                            </div>
                            <div class="text-sm font-medium">
                                {show.data.regia}
                            </div>
                        </div>
                    )}
                    {show.data.produzione && (
                        <div>
                            <div class="text-xs text-muted-foreground uppercase tracking-wider mb-1">
                                Produzione
                            </div>
                            <div class="text-sm font-medium">
                                {show.data.produzione}
                            </div>
                        </div>
                    )}
                    {show.data.tecnico && (
                        <div>
                            <div class="text-xs text-muted-foreground uppercase tracking-wider mb-1">
                                Tecnico
                            </div>
                            <div class="text-sm font-medium">
                                {show.data.tecnico}
                            </div>
                        </div>
                    )}
                    {show.data.costo && (
                        <div>
                            <div class="text-xs text-muted-foreground uppercase tracking-wider mb-1">
                                Costo
                            </div>
                            <div class="text-sm font-medium text-primary font-bold">
                                {show.data.costo}
                            </div>
                        </div>
                    )}
                </div>
            )
        }

        <div
            class="aspect-video w-full bg-muted rounded-2xl overflow-hidden relative mb-12 border border-border"
        >
            <div
                class="absolute inset-0 flex items-center justify-center text-muted-foreground font-serif text-2xl"
            >
                Immagine {show.data.title}
            </div>
        </div>

        <div
            class="prose prose-invert prose-blue max-w-none prose-headings:font-serif prose-h2:text-3xl prose-h2:mt-12"
        >
            <Content />
        </div>

        <div class="mt-16 pt-8 border-t border-border text-center">
            <h3 class="text-2xl font-serif font-bold mb-4">
                Sei interessato a questo spettacolo?
            </h3>
            <a
                href="/#contatti"
                class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-8"
            >
                Richiedi Informazioni
            </a>
        </div>
    </article>
</Layout>
