---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
    const spettacoli = await getCollection("spettacoli");
    return spettacoli.map((show) => ({
        params: { slug: show.id },
        props: { show },
    }));
}

const { show } = Astro.props;
const { Content } = await render(show);
---

<Layout
    title={`${show.data.title} | Sergio Procopio`}
    description={show.data.description}
>
    <div class="relative overflow-hidden bg-[#09090b]">
        <div
            class="absolute top-0 right-0 w-[60%] h-[60%] bg-primary/5 rounded-full blur-[140px] pointer-events-none"
        >
        </div>

        <article
            class="container relative z-10 mx-auto px-4 py-32 min-h-screen max-w-5xl"
        >
            <div class="mb-20">
                <h1
                    class="text-6xl md:text-8xl font-serif font-bold mb-8 tracking-tight leading-[0.9]"
                >
                    {show.data.title}
                </h1>
                <p
                    class="text-2xl text-muted-foreground italic leading-relaxed max-w-3xl opacity-90"
                >
                    {show.data.description}
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                <div class="lg:col-span-8 space-y-10">
                    <div
                        class="aspect-video w-full bg-zinc-900 rounded-[2.5rem] overflow-hidden relative border border-white/5 shadow-2xl"
                    >
                        {
                            show.data.image ? (
                                <Image
                                    src={show.data.image}
                                    alt={show.data.title}
                                    class="w-full h-full object-cover"
                                />
                            ) : (
                                <div class="absolute inset-0 flex items-center justify-center text-muted-foreground font-serif text-3xl opacity-10">
                                    {show.data.title}
                                </div>
                            )
                        }
                        <div
                            class="absolute inset-0 bg-linear-to-t from-[#09090b]/80 via-transparent to-transparent"
                        >
                        </div>
                    </div>

                    <div
                        class="prose prose-invert max-w-none prose-headings:font-serif prose-h2:text-4xl prose-h2:font-medium prose-h2:text-foreground prose-h2:tracking-tight prose-h2:mt-24 prose-h2:mb-10 prose-h2:pb-6 prose-h2:border-b prose-h2:border-white/10 prose-h2:first:mt-0 prose-p:text-[1.125rem] prose-p:leading-[1.9] prose-p:text-muted-foreground/90 prose-p:font-light prose-p:mb-8 prose-li:text-muted-foreground/90 prose-li:font-light prose-strong:text-foreground prose-strong:font-medium"
                    >
                        <Content />
                    </div>
                </div>

                <div class="lg:col-span-4 space-y-8">
                    <div
                        class="p-8 bg-white/2 border border-white/10 rounded-[2.5rem] sticky top-32 backdrop-blur-sm"
                    >
                        <h3
                            class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-8 flex items-center gap-4"
                        >
                            <span class="w-8 h-px bg-primary/30"></span> Dati Tecnici
                        </h3>

                        <div class="space-y-6">
                            {
                                show.data.produzione && (
                                    <div>
                                        <div class="text-[10px] uppercase tracking-widest text-muted-foreground mb-2">
                                            Produzione
                                        </div>
                                        <div class="text-lg font-bold font-serif">
                                            {show.data.produzione}
                                        </div>
                                    </div>
                                )
                            }
                            {
                                show.data.regia && (
                                    <div>
                                        <div class="text-[10px] uppercase tracking-widest text-muted-foreground mb-2">
                                            Regia
                                        </div>
                                        <div class="text-lg font-bold font-serif">
                                            {show.data.regia}
                                        </div>
                                    </div>
                                )
                            }
                            {
                                show.data.etaConsigliata && (
                                    <div>
                                        <div class="text-[10px] uppercase tracking-widest text-muted-foreground mb-2">
                                            Età Consigliata
                                        </div>
                                        <div class="text-lg font-bold font-serif">
                                            {show.data.etaConsigliata}
                                        </div>
                                    </div>
                                )
                            }
                            {
                                (show.data.durataDettaglio ||
                                    show.data.duration) && (
                                    <div>
                                        <div class="text-[10px] uppercase tracking-widest text-muted-foreground mb-2">
                                            Durata
                                        </div>
                                        <div class="text-lg font-bold font-serif">
                                            {show.data.durataDettaglio ||
                                                show.data.duration}
                                        </div>
                                    </div>
                                )
                            }
                            {
                                show.data.tecnico && (
                                    <div>
                                        <div class="text-[10px] uppercase tracking-widest text-muted-foreground mb-2">
                                            Cast Tecnico
                                        </div>
                                        <div class="text-lg font-bold font-serif">
                                            {show.data.tecnico}
                                        </div>
                                    </div>
                                )
                            }

                            {
                                show.data.minimoAlunni && (
                                    <div>
                                        <div class="text-[10px] uppercase tracking-widest text-muted-foreground mb-2">
                                            Requisiti
                                        </div>
                                        <div class="text-lg font-bold font-serif">
                                            {show.data.minimoAlunni}
                                        </div>
                                    </div>
                                )
                            }
                            {
                                (show.data.noteAttuazione ||
                                    show.data.spazioScenico ||
                                    show.data.oscuramento) && (
                                    <div class="text-sm font-medium text-muted-foreground/80 space-y-2 pt-4 border-t border-white/5">
                                        {show.data.noteAttuazione && (
                                            <p>{show.data.noteAttuazione}</p>
                                        )}
                                        <ul class="space-y-1">
                                            {show.data.spazioScenico && (
                                                <li>
                                                    • {show.data.spazioScenico}
                                                </li>
                                            )}
                                            {show.data.oscuramento && (
                                                <li>
                                                    • {show.data.oscuramento}
                                                </li>
                                            )}
                                        </ul>
                                    </div>
                                )
                            }
                        </div>

                        <div class="mt-12 pt-10 border-t border-white/5">
                            <a
                                href="/#contatti"
                                class="flex w-full h-14 items-center justify-center rounded-2xl bg-primary text-primary-foreground font-bold uppercase tracking-widest hover:bg-primary/90 transition-all shadow-lg shadow-primary/20 active:scale-[0.98]"
                            >
                                Prenota Ora
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </article>
    </div>
</Layout>
