---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const spettacoli = await getCollection("spettacoli");
    return spettacoli.map((show) => ({
        params: { slug: show.id },
        props: { show },
    }));
}

const { show } = Astro.props;
const { Content } = await render(show);
---

<Layout
    title={`${show.data.title} | Sergio Procopio`}
    description={show.data.description}
>
    <div class="relative overflow-hidden bg-[#09090b]">
        <div
            class="absolute top-0 right-0 w-[60%] h-[60%] bg-primary/5 rounded-full blur-[140px] pointer-events-none"
        >
        </div>

        <article
            class="container relative z-10 mx-auto px-4 py-32 min-h-screen max-w-5xl"
        >
            <div class="mb-20">
                <a
                    href="/spettacoli"
                    class="inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-primary hover:text-foreground transition-all mb-12"
                >
                    <span class="w-8 h-[1px] bg-primary"></span> Torna al catalogo
                </a>

                <div class="flex flex-wrap items-center gap-3 mb-8">
                    <span
                        class="px-4 py-1.5 bg-primary/10 backdrop-blur-md border border-primary/20 text-primary rounded-full text-[10px] font-bold uppercase tracking-wider"
                        >{show.data.category}</span
                    >
                    {
                        show.data.etaConsigliata && (
                            <span class="px-4 py-1.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-wider">
                                👥 {show.data.etaConsigliata}
                            </span>
                        )
                    }
                    {
                        show.data.duration && (
                            <span class="px-4 py-1.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-wider">
                                ⏱️ {show.data.duration}
                            </span>
                        )
                    }
                </div>

                <h1
                    class="text-6xl md:text-8xl font-serif font-bold mb-8 tracking-tight leading-[0.9]"
                >
                    {show.data.title}
                </h1>
                <p
                    class="text-2xl text-muted-foreground italic leading-relaxed max-w-3xl opacity-90"
                >
                    {show.data.description}
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
                <div class="lg:col-span-8 space-y-16">
                    <div
                        class="aspect-video w-full bg-zinc-900 rounded-[2.5rem] overflow-hidden relative border border-white/5 shadow-2xl"
                    >
                        <div
                            class="absolute inset-0 flex items-center justify-center text-muted-foreground font-serif text-3xl opacity-10"
                        >
                            {show.data.title}
                        </div>
                        <div
                            class="absolute inset-0 bg-gradient-to-t from-[#09090b]/80 via-transparent to-transparent"
                        >
                        </div>
                    </div>

                    <div
                        class="prose prose-invert prose-blue max-w-none prose-headings:font-serif prose-h2:text-4xl prose-h2:tracking-tight prose-p:text-lg prose-p:text-muted-foreground prose-p:leading-relaxed prose-li:text-muted-foreground"
                    >
                        <Content />
                    </div>
                </div>

                <div class="lg:col-span-4 space-y-8">
                    <div
                        class="p-10 bg-white/[0.02] border border-white/10 rounded-[2.5rem] sticky top-32 backdrop-blur-sm"
                    >
                        <h3
                            class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-10 flex items-center gap-4"
                        >
                            <span class="w-8 h-[1px] bg-primary/30"></span> Dati Tecnici
                        </h3>

                        <div class="space-y-10">
                            {
                                show.data.regia && (
                                    <div>
                                        <div class="text-[10px] uppercase tracking-widest text-muted-foreground mb-2">
                                            Regia
                                        </div>
                                        <div class="text-lg font-bold font-serif">
                                            {show.data.regia}
                                        </div>
                                    </div>
                                )
                            }
                            {
                                show.data.produzione && (
                                    <div>
                                        <div class="text-[10px] uppercase tracking-widest text-muted-foreground mb-2">
                                            Produzione
                                        </div>
                                        <div class="text-lg font-bold font-serif">
                                            {show.data.produzione}
                                        </div>
                                    </div>
                                )
                            }
                            {
                                show.data.tecnico && (
                                    <div>
                                        <div class="text-[10px] uppercase tracking-widest text-muted-foreground mb-2">
                                            Cast Tecnico
                                        </div>
                                        <div class="text-lg font-bold font-serif">
                                            {show.data.tecnico}
                                        </div>
                                    </div>
                                )
                            }
                            {
                                show.data.costo && (
                                    <div>
                                        <div class="text-[10px] uppercase tracking-widest text-muted-foreground mb-2">
                                            Investimento
                                        </div>
                                        <div class="text-3xl font-bold font-serif text-primary">
                                            {show.data.costo}
                                        </div>
                                        <div class="text-[9px] uppercase tracking-tighter opacity-40 mt-1">
                                            Include audio, luci e assistenza
                                        </div>
                                    </div>
                                )
                            }
                        </div>

                        <div class="mt-12 pt-10 border-t border-white/5">
                            <a
                                href="/#contatti"
                                class="flex w-full h-14 items-center justify-center rounded-2xl bg-primary text-primary-foreground font-bold uppercase tracking-widest hover:bg-primary/90 transition-all shadow-lg shadow-primary/20 active:scale-[0.98]"
                            >
                                Prenota Ora
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </article>
    </div>
</Layout>
