---
import Layout from "../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";
import { getImage } from "astro:assets";
import { getShowSpecs } from "../../lib/show-specs";
import { getImageTitleFromPath } from "../../lib/show-assets";
import ShowGallery from "../../components/custom/ShowGallery";
import UpcomingDates from "../../components/custom/UpcomingDates.astro";

const show = Astro.params.slug
    ? await getEntry("spettacoli", Astro.params.slug)
    : undefined;

if (!show || show.data.draft) {
    return Astro.rewrite("/404");
}

const { Content } = await render(show);
const specGroups = getShowSpecs(show);

const normalizeTitle = (title: string) => title.trim().toLowerCase();
const showEvents = (await getCollection("eventi")).filter(
    (event) => normalizeTitle(event.data.spettacolo) === normalizeTitle(show.data.title),
);

const explicitShowImages = show.data.galleryImages.map((image, index) => ({
    src: image,
    alt: `${show.data.title} - immagine ${index + 1}`,
    title: show.data.title,
    subtitle: getImageTitleFromPath(image.src) || `immagine ${index + 1}`,
    width: image.width,
    height: image.height,
}));

const showImagesBySource = new Map<string, (typeof explicitShowImages)[number]>();
for (const image of explicitShowImages) {
    showImagesBySource.set(image.src.src, image);
}
const allShowImages = Array.from(showImagesBySource.values());

// Ottimizziamo tutte le immagini dello spettacolo in parallelo lato server
const showImages = await Promise.all(
    allShowImages.map(async (image) => {
        const optimizedLarge = await getImage({
            src: image.src,
            width: 1200,
            format: "webp",
            quality: 80,
        });

        const optimizedGrid = await getImage({
            src: image.src,
            width: 600,
            format: "webp",
            quality: 75,
        });

        const optimizedThumb = await getImage({
            src: image.src,
            width: 120,
            height: 120,
            format: "webp",
            quality: 60,
        });

        return {
            src: optimizedLarge.src,
            gridSrc: optimizedGrid.src,
            thumbSrc: optimizedThumb.src,
            originalSrc: image.src.src,
            alt: image.alt,
            title: image.title,
            subtitle: image.subtitle,
            width: image.width,
            height: image.height,
        };
    })
);

// E per l'immagine principale: la ottimizziamo anche per un caricamento istantaneo
let optimizedMainImage = "";
if (show.data.image) {
    const optimized = await getImage({
        src: show.data.image,
        width: 1000,
        format: "webp",
        quality: 80,
    });
    optimizedMainImage = optimized.src;
}

const site = Astro.site ?? new URL("https://sergioprocopio.it");
const showSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": show.data.title,
  "description": show.data.description,
  "image": show.data.image ? new URL(show.data.image.src, site).toString() : undefined,
  "brand": {
    "@type": "Person",
    "name": "Sergio Procopio"
  },
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/InStock",
    "url": new URL(`/spettacoli/${show.id}`, site).toString()
  }
};
---

<Layout
    title={`${show.data.title} | Sergio Procopio`}
    description={show.data.description}
    canonicalPath={`/spettacoli/${show.id}`}
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(showSchema)} />
    <article class="container mx-auto min-h-screen px-4 pb-24 pt-36 md:px-8 lg:px-12">
        <header class="mb-16 lg:mb-20">
            <h1 class="max-w-5xl text-[clamp(2.25rem,6.5vw,6rem)] uppercase leading-[0.95]">
                {show.data.title}
            </h1>
            <p class="mt-6 max-w-3xl text-xl font-light leading-relaxed text-foreground/85 lg:text-2xl">
                {show.data.description}
            </p>
        </header>

        <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
            <div class="flex flex-col gap-16 lg:col-span-8">
                {
                    show.data.image ? (
                        <ShowGallery
                            client:load
                            mainImageSrc={optimizedMainImage}
                            mainImageWidth={show.data.image.width}
                            mainImageHeight={show.data.image.height}
                            mainImageOriginalSrc={show.data.image.src}
                            images={showImages}
                            alt={show.data.title}
                        />
                    ) : (
                        <div class="flex aspect-video w-full items-center justify-center bg-secondary text-3xl uppercase text-foreground/15">
                            {show.data.title}
                        </div>
                    )
                }

                <div class="richtext">
                    <Content />
                </div>
            </div>

            <aside class="lg:col-span-4">
                <div class="border-t border-border pt-8 lg:sticky lg:top-28">
                    <h2 class="mb-8 text-xs font-medium uppercase tracking-[0.24em] text-primary-soft">
                        Dati tecnici
                    </h2>

                    <dl class="space-y-6">
                        {
                            specGroups.flatMap((group) =>
                                group.items.map((item) => (
                                    <div>
                                        <dt class="mb-1 text-[11px] uppercase tracking-[0.2em] text-muted-foreground">
                                            {item.label}
                                        </dt>
                                        <dd class="text-lg">{item.value}</dd>
                                    </div>
                                )),
                            )
                        }
                    </dl>

                    <UpcomingDates events={showEvents} />

                    <a
                        href="/contatti"
                        class="mt-10 flex min-h-14 w-full items-center justify-center bg-primary text-xs font-medium uppercase tracking-[0.18em] text-primary-foreground transition-[background-color,scale] hover:bg-primary-hover active:scale-[0.98]"
                    >
                        Prenota ora
                    </a>
                </div>
            </aside>
        </div>
    </article>
</Layout>
