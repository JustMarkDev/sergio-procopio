---
import Layout from "../../layouts/Layout.astro";
import { getEntry, render } from "astro:content";
import { getImage } from "astro:assets";
import { getShowSpecs } from "../../lib/show-specs";
import { getImageTitleFromPath } from "../../lib/show-assets";
import ShowGallery from "../../components/custom/ShowGallery";

const show = Astro.params.slug
    ? await getEntry("spettacoli", Astro.params.slug)
    : undefined;

if (!show || show.data.draft) {
    return Astro.rewrite("/404");
}

const { Content } = await render(show);
const specGroups = getShowSpecs(show);

const explicitShowImages = show.data.galleryImages.map((image, index) => ({
    src: image,
    alt: `${show.data.title} - immagine ${index + 1}`,
    title: show.data.title,
    subtitle: getImageTitleFromPath(image.src) || `immagine ${index + 1}`,
    width: image.width,
    height: image.height,
}));

const showImagesBySource = new Map<string, (typeof explicitShowImages)[number]>();
for (const image of explicitShowImages) {
    showImagesBySource.set(image.src.src, image);
}
const allShowImages = Array.from(showImagesBySource.values());

// Ottimizziamo tutte le immagini dello spettacolo in parallelo lato server
const showImages = await Promise.all(
    allShowImages.map(async (image) => {
        const optimizedLarge = await getImage({
            src: image.src,
            width: 1200,
            format: "webp",
            quality: 80,
        });

        const optimizedGrid = await getImage({
            src: image.src,
            width: 600,
            format: "webp",
            quality: 75,
        });

        const optimizedThumb = await getImage({
            src: image.src,
            width: 120,
            height: 120,
            format: "webp",
            quality: 60,
        });

        return {
            src: optimizedLarge.src,
            gridSrc: optimizedGrid.src,
            thumbSrc: optimizedThumb.src,
            originalSrc: image.src.src,
            alt: image.alt,
            title: image.title,
            subtitle: image.subtitle,
            width: image.width,
            height: image.height,
        };
    })
);

// E per l'immagine principale: la ottimizziamo anche per un caricamento istantaneo
let optimizedMainImage = "";
if (show.data.image) {
    const optimized = await getImage({
        src: show.data.image,
        width: 1000,
        format: "webp",
        quality: 80,
    });
    optimizedMainImage = optimized.src;
}

const site = Astro.site ?? new URL("https://sergioprocopio.it");
const showSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": show.data.title,
  "description": show.data.description,
  "image": show.data.image ? new URL(show.data.image.src, site).toString() : undefined,
  "brand": {
    "@type": "Person",
    "name": "Sergio Procopio"
  },
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/InStock",
    "url": new URL(`/spettacoli/${show.id}`, site).toString()
  }
};
---

<Layout
    title={`${show.data.title} | Sergio Procopio`}
    description={show.data.description}
    canonicalPath={`/spettacoli/${show.id}`}
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(showSchema)} />
    <div class="relative overflow-hidden bg-[#09090b]">
        <div
            class="absolute top-0 right-0 w-[60%] h-[60%] bg-primary/5 rounded-full blur-[140px] pointer-events-none"
        >
        </div>

        <article class="container relative z-10 mx-auto px-4 md:px-8 lg:px-12 py-32 min-h-screen">
            <div class="mb-20">
                <h1
                    class="text-6xl md:text-8xl font-serif font-bold mb-8 tracking-tight leading-[0.9]"
                >
                    {show.data.title}
                </h1>
                <p
                    class="text-2xl text-muted-foreground italic leading-relaxed max-w-3xl opacity-90"
                >
                    {show.data.description}
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                <div class="lg:col-span-8 space-y-16">
                    {
                        show.data.image ? (
                            <ShowGallery
                                client:load
                                mainImageSrc={optimizedMainImage}
                                mainImageOriginalSrc={show.data.image.src}
                                images={showImages}
                                alt={show.data.title}
                            />
                        ) : (
                            <div class="rounded-[2.5rem] overflow-hidden border border-white/5 shadow-2xl bg-[#09090b]">
                                <div class="aspect-video w-full bg-zinc-900/50 flex items-center justify-center text-muted-foreground font-serif text-3xl opacity-10">
                                    {show.data.title}
                                </div>
                            </div>
                        )
                    }

                    <div
                        class="pt-16 [&_h2]:font-serif [&_h2]:text-4xl [&_h2]:font-medium [&_h2]:text-foreground [&_h2]:tracking-tight [&_h2]:mt-24 [&_h2]:mb-10 [&_h2]:pb-6 [&_h2]:border-b [&_h2]:border-white/10 [&_h2:first-child]:mt-0 [&_p]:text-lg [&_p]:leading-[1.9] [&_p]:text-muted-foreground/90 [&_p]:font-light [&_p]:mb-8 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-8 [&_li]:text-muted-foreground/90 [&_li]:font-light [&_li]:mb-2 [&_strong]:text-foreground [&_strong]:font-medium"
                    >
                        <Content />
                    </div>
                </div>

                <div class="lg:col-span-4 space-y-8">
                    <div
                        class="p-8 bg-white/2 border border-white/10 rounded-[2.5rem] sticky top-32 backdrop-blur-sm"
                    >
                        <h3
                            class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-8 flex items-center gap-4"
                        >
                            <span class="w-8 h-px bg-primary/30"></span> Dati Tecnici
                        </h3>

                        <div class="space-y-6">
                            {
                                specGroups.map((group) => (
                                    <div>
                                        {group.items.map((item) => (
                                            <div class="mb-6 last:mb-0">
                                                <div class="text-[10px] uppercase tracking-widest text-muted-foreground mb-2">
                                                    {item.label}
                                                </div>
                                                <div class="text-lg font-bold font-serif">
                                                    {item.value}
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                ))
                            }
                        </div>

                        <div class="mt-12 pt-10 border-t border-white/5">
                            <a
                                href="/#contatti"
                                class="flex w-full h-14 items-center justify-center rounded-2xl bg-primary text-primary-foreground font-bold uppercase tracking-widest hover:bg-primary/90 transition-all shadow-lg shadow-primary/20 active:scale-[0.98]"
                            >
                                Prenota Ora
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </article>
    </div>
</Layout>
