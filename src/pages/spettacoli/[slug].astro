---
import { jsonLd } from "../../lib/json-ld";
import Layout from "../../layouts/Layout.astro";
import { getEntry, render } from "astro:content";
import { getImage } from "astro:assets";
import { getImageTitleFromPath } from "../../lib/show-assets";
import { SITE_URL } from "../../consts";
import { getCalendarEvents, normalizeTitle } from "../../lib/events";
import { optimizeGalleryImages } from "../../lib/gallery-images";
import ShowGallery from "../../components/custom/ShowGallery";
import FactStrip from "../../components/custom/FactStrip.astro";
import InfoSection from "../../components/custom/InfoSection.astro";

const show = Astro.params.slug
    ? await getEntry("spettacoli", Astro.params.slug)
    : undefined;

if (!show || show.data.draft) {
    return Astro.rewrite("/404");
}

const { Content } = await render(show);

const showEvents = (await getCalendarEvents()).filter(
    (event) => event.kind === "spettacolo" && normalizeTitle(event.data.name) === normalizeTitle(show.data.title),
);

const showImages = await optimizeGalleryImages(
    show.data.galleryImages.map((image, index) => ({
        src: image,
        alt: `${show.data.title} - immagine ${index + 1}`,
        title: show.data.title,
        subtitle: getImageTitleFromPath(image.src) || `immagine ${index + 1}`,
        width: image.width,
        height: image.height,
    })),
);

// E per l'immagine principale: la ottimizziamo anche per un caricamento istantaneo
let optimizedMainImage = "";
let optimizedMainImageSrcSet: string | undefined;
if (show.data.image) {
    const optimized = await getImage({
        src: show.data.image,
        width: 1000,
        widths: [640, 1000, 1500],
        format: "webp",
        quality: 80,
    });
    optimizedMainImage = optimized.src;
    optimizedMainImageSrcSet = optimized.srcSet.attribute;
}

const site = new URL(SITE_URL);
const showSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": show.data.title,
  "description": show.data.description,
  "image": show.data.image ? new URL(show.data.image.src, site).toString() : undefined,
  "creator": {
    "@type": "Person",
    "name": "Sergio Procopio"
  },
  "url": new URL(`/spettacoli/${show.id}`, site).toString()
};

const facts = [
    { label: "Durata", value: show.data.durata },
    { label: "Età consigliata", value: show.data.eta },
    { label: "Regia", value: show.data.regia },
];

const notes = [
    { label: "Tecnico audio/luci", value: show.data.tecnico },
    { label: "Requisiti", value: show.data.requisiti },
    { label: "Costo", value: show.data.costo },
];
---

<Layout
    title={`${show.data.title} | Sergio Procopio`}
    description={show.data.description}
    canonicalPath={`/spettacoli/${show.id}`}
>
    <script type="application/ld+json" is:inline set:html={jsonLd(showSchema)} />
    <article class="container mx-auto min-h-screen px-4 pb-24 pt-36 md:px-8 lg:px-12">
        <header class="mb-12 lg:mb-16">
            <p class="mb-5 text-xs font-medium uppercase tracking-[0.24em] text-primary-soft">
                {show.data.category}
            </p>
            <h1 class="max-w-5xl text-[clamp(2.25rem,6.5vw,6rem)] uppercase leading-[0.95]">
                {show.data.title}
            </h1>
            <p class="mt-6 max-w-3xl text-xl font-light leading-relaxed text-foreground/85 lg:text-2xl">
                {show.data.description}
            </p>
        </header>

        <FactStrip facts={facts} />

        {
            show.data.image ? (
                <ShowGallery
                    client:idle
                    mainImageSrc={optimizedMainImage}
                    mainImageSrcSet={optimizedMainImageSrcSet}
                    mainImageWidth={show.data.image.width}
                    mainImageHeight={show.data.image.height}
                    mainImageOriginalSrc={show.data.image.src}
                    images={showImages}
                    alt={show.data.title}
                />
            ) : (
                <div class="flex aspect-video w-full items-center justify-center bg-secondary text-3xl uppercase text-foreground/15">
                    {show.data.title}
                </div>
            )
        }

        <div class="richtext split mt-16 lg:mt-24">
            <Content />
        </div>

        <InfoSection events={showEvents} notes={notes} />
    </article>
</Layout>
