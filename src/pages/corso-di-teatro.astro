---
import Layout from "../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { COURSE_PATH } from "../consts";
import FactStrip from "../components/custom/FactStrip.astro";
import InfoSection from "../components/custom/InfoSection.astro";

const show = (await getCollection("corso"))[0];

if (!show) {
    return Astro.rewrite("/404");
}

const { Content } = await render(show);

const courseEvents = await getCollection("dateCorso");

const facts = [
    { label: "Docente", value: show.data.docente },
    { label: "Età", value: show.data.eta },
];

const notes = [
    { label: "Per chi", value: show.data.destinatari },
    { label: "Durata", value: show.data.durata },
    { label: "Dove", value: show.data.sede },
    { label: "Costo", value: show.data.costo },
];

const site = Astro.site ?? new URL("https://sergioprocopio.it");
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": show.data.title,
  "description": show.data.description,
  "image": show.data.image ? new URL(show.data.image.src, site).toString() : undefined,
  "url": new URL(COURSE_PATH, site).toString(),
  "provider": {
    "@type": "Person",
    "name": show.data.docente
  }
};
---

<Layout
    title={`${show.data.title} | Sergio Procopio`}
    description={show.data.description}
    canonicalPath={COURSE_PATH}
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(courseSchema)} />
    <article class="container mx-auto min-h-screen px-4 pb-24 pt-36 md:px-8 lg:px-12">
        <header class="mb-12 lg:mb-16">
            <h1 class="max-w-5xl text-[clamp(2.25rem,6.5vw,6rem)] uppercase leading-[0.95]">
                {show.data.title}
            </h1>
            <p class="mt-6 max-w-3xl text-xl font-light leading-relaxed text-foreground/85 lg:text-2xl">
                {show.data.description}
            </p>
        </header>

        <FactStrip facts={facts} />

        {
            show.data.image ? (
                <Image
                    src={show.data.image}
                    widths={[640, 1000, 1500]}
                    sizes="(min-width: 1024px) 1200px, calc(100vw - 32px)"
                    format="webp"
                    quality={80}
                    alt={show.data.title}
                    loading="eager"
                    fetchpriority="high"
                    class="block h-auto w-full"
                />
            ) : (
                <div class="flex aspect-video w-full items-center justify-center bg-secondary text-3xl uppercase text-foreground/15">
                    {show.data.title}
                </div>
            )
        }

        <div class="richtext split mt-16 lg:mt-24">
            <Content />
        </div>

        <InfoSection events={courseEvents} notes={notes} contactLabel="Scrivici per il tuo gruppo" />
    </article>
</Layout>
