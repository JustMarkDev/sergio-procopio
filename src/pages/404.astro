---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import curtain from "../../photoshoot/MyPhoto_197.webp";

Astro.response.status = 404;
---

<Layout title="Pagina Non Trovata | Sergio Procopio" noindex>
    <div class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-y-0 right-0 w-full opacity-60 mask-[linear-gradient(to_right,transparent,black_55%)] lg:w-3/4" aria-hidden="true">
        <Image src={curtain} alt="" widths={[640, 1000, 1500]} sizes="(min-width: 1024px) 75vw, 100vw" format="webp" quality={75} class="h-full w-full object-cover" />
    </div>
    <div class="container relative mx-auto flex min-h-[70vh] flex-col justify-center px-4 pb-24 pt-36 md:px-8 lg:px-12">
        <h1 class="text-[clamp(5rem,18vw,14rem)] leading-[0.85] text-primary-soft">404</h1>
        <h2 class="mt-6 text-2xl uppercase md:text-4xl">Il sipario è calato su questa pagina</h2>
        <p class="mt-4 max-w-md font-light text-muted-foreground">
            La pagina che stai cercando sembra essere uscita di scena o non è mai esistita.
        </p>
        <a
            href="/"
            class="mt-8 inline-flex min-h-12 w-fit items-center justify-center whitespace-nowrap bg-primary px-7 text-xs font-medium uppercase tracking-[0.18em] text-primary-foreground transition-[background-color,scale] hover:bg-primary-hover active:scale-[0.98]"
        >
            Torna alla home
        </a>

        <nav class="mt-14 max-w-md" aria-label="Dove trovare i contenuti">
            <h2 class="mb-3 text-xs font-medium uppercase tracking-[0.24em] text-muted-foreground">Dove cercare</h2>
            <ul class="space-y-1 text-sm font-light text-muted-foreground">
                <li><a class="hover:text-primary-soft" href="/llms.txt">Guida per agenti (llms.txt)</a></li>
                <li><a class="hover:text-primary-soft" href="/sitemap.md">Sitemap Markdown</a></li>
                <li><a class="hover:text-primary-soft" href="/sitemap.xml">Sitemap XML</a></li>
                <li><a class="hover:text-primary-soft" href="/spettacoli">Catalogo degli spettacoli</a></li>
                <li><a class="hover:text-primary-soft" href="/calendario">Calendario degli eventi</a></li>
                <li><a class="hover:text-primary-soft" href="/biografia">Biografia</a></li>
                <li><a class="hover:text-primary-soft" href="/about">About Sergio Procopio</a></li>
                <li><a class="hover:text-primary-soft" href="/contatti">Contatti</a></li>
                <li><a class="hover:text-primary-soft" href="/contact">Contact</a></li>
                <li><a class="hover:text-primary-soft" href="/privacy">Privacy</a></li>
            </ul>
        </nav>
    </div>
    </div>
</Layout>
