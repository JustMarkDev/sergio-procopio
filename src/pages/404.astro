---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Pagina Non Trovata | Sergio Procopio">
    <div class="min-h-[70vh] flex items-center justify-center pt-20">
        <div class="text-center px-4">
            <h1
                class="text-7xl md:text-9xl font-serif font-bold text-primary mb-4"
            >
                404
            </h1>
            <h2 class="text-2xl md:text-3xl font-serif font-semibold mb-6">
                Il sipario è calato su questa pagina
            </h2>
            <p class="text-muted-foreground max-w-md mx-auto mb-8">
                La pagina che stai cercando sembra essere uscita di scena o non
                è mai esistita.
            </p>
            <a
                href="/"
                class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 bg-primary-deep text-primary-foreground hover:bg-primary-deep/90 h-11 px-8"
            >
                Torna alla Home
            </a>
        </div>
    </div>
</Layout>
