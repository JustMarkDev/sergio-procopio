---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import { splitEventsByDate } from "../lib/calendar-dates";

const eventi = (await getCollection("eventi"))
    .filter((event) => !event.data.draft && event.data.isPublic)
    .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const { upcomingEvents, pastEvents } = splitEventsByDate(eventi);

const dateFormatter = new Intl.DateTimeFormat("it-IT", {
    timeZone: "Europe/Rome",
    weekday: "long",
    day: "2-digit",
    month: "long",
    year: "numeric",
});

const formatDate = (date: Date) => dateFormatter.format(date);
const dayFormatter = new Intl.DateTimeFormat("it-IT", {
    day: "2-digit",
    timeZone: "Europe/Rome",
});
const monthYearFormatter = new Intl.DateTimeFormat("it-IT", {
    month: "short",
    year: "numeric",
    timeZone: "Europe/Rome",
});
const normalizeTitle = (title: string) => title.trim().toLowerCase();
const displayedShowTitles = new Set(
    [...upcomingEvents, ...pastEvents.slice(0, 8)].map((event) =>
        normalizeTitle(event.data.spettacolo),
    ),
);
const shows = (await getCollection("spettacoli")).filter(
    (show) => !show.data.draft && displayedShowTitles.has(normalizeTitle(show.data.title)),
);
const showsByTitle = new Map(
    await Promise.all(shows.map(async (show) => {
        const image = show.data.image;
        const optimized = image ? await getImage({
            src: image,
            widths: [160, 400, 640],
            format: "webp",
            quality: 75,
        }) : undefined;

        // A published show's link does not depend on it having a photo.
        return [normalizeTitle(show.data.title), {
            id: show.id,
            image: image && optimized ? {
                src: optimized.src,
                srcset: optimized.srcSet.attribute,
                width: image.width,
                height: image.height,
            } : undefined,
        }] as const;
    })),
);
---

<Layout
    title="Calendario | Sergio Procopio"
    description="Calendario ufficiale degli spettacoli e degli eventi di Sergio Procopio."
>
    <div class="relative overflow-hidden bg-[#09090b] min-h-screen">
        <div
            class="absolute top-0 left-0 w-full h-[50vh] bg-[radial-gradient(ellipse_at_top,rgba(37,99,235,0.06)_0%,transparent_70%)] pointer-events-none"
        >
        </div>

        <div class="container relative z-10 mx-auto px-4 md:px-8 lg:px-12 py-32">
            <div class="max-w-4xl mb-16">
                <h1 class="text-5xl md:text-7xl font-serif font-bold mb-6 tracking-tight">
                    Calendario <span class="italic text-primary">ufficiale</span>
                </h1>
                <p class="text-xl text-muted-foreground max-w-2xl italic opacity-80 leading-relaxed">
                    Date pubbliche, spettacoli e appuntamenti in programma.
                </p>
            </div>

            <section class="mb-20">
                <div class="flex items-center gap-4 mb-8">
                    <span class="h-px w-10 bg-primary/40"></span>
                    <h2 class="text-sm font-bold uppercase tracking-[0.25em] text-blue-400">
                        Prossimi eventi
                    </h2>
                </div>

                {
                    upcomingEvents.length > 0 ? (
                        <div class="space-y-6 md:space-y-8">
                            {upcomingEvents.map((event, index) => {
                                const show = showsByTitle.get(normalizeTitle(event.data.spettacolo));
                                return (
                                <article class="flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-white/4 hover:border-primary/40 transition-colors md:flex-row">
                                    <div class="relative aspect-video w-full shrink-0 overflow-hidden bg-white/5 md:aspect-auto md:w-80">
                                        {show?.image ? (
                                            <img
                                                src={show.image.src}
                                                srcset={show.image.srcset}
                                                sizes="(min-width: 768px) 320px, calc(100vw - 32px)"
                                                alt={event.data.spettacolo}
                                                width={show.image.width}
                                                height={show.image.height}
                                                loading={index === 0 ? "eager" : "lazy"}
                                                decoding="async"
                                                class="absolute inset-0 h-full w-full object-cover"
                                            />
                                        ) : (
                                            <div aria-hidden="true" class="absolute inset-0 flex items-center justify-center px-6 pt-16 text-center font-serif text-3xl font-bold text-white/20">
                                                {event.data.spettacolo}
                                            </div>
                                        )}
                                        <div aria-hidden="true" class="absolute inset-0 bg-linear-to-t from-black/40 to-transparent" />
                                        <div aria-hidden="true" class="absolute left-4 top-4 flex flex-col items-center rounded-2xl border border-white/10 bg-black/75 px-4 py-3">
                                            <span class="font-serif text-3xl font-bold leading-none text-primary">
                                                {dayFormatter.format(event.data.date)}
                                            </span>
                                            <span class="mt-1 text-[10px] font-bold uppercase tracking-widest text-white/85">
                                                {monthYearFormatter.format(event.data.date)}
                                            </span>
                                        </div>
                                    </div>

                                    <div class="flex min-w-0 grow flex-col justify-center gap-3 p-6 md:p-8">
                                        <p class="text-xs font-bold uppercase tracking-widest text-blue-400">
                                            {formatDate(event.data.date)}
                                            {event.data.time && ` - ore ${event.data.time}`}
                                        </p>
                                        <h3 class="text-2xl md:text-3xl font-serif font-bold leading-tight wrap-break-word">
                                            {event.data.spettacolo}
                                        </h3>
                                        <p class="text-muted-foreground leading-relaxed wrap-break-word">
                                            {event.data.venue}, {event.data.city}
                                            {event.data.address && ` - ${event.data.address}`}
                                        </p>
                                        <div class="mt-3 flex flex-wrap items-center gap-3">
                                        {show && (
                                            <a
                                                href={`/spettacoli/${show.id}`}
                                                class="inline-flex min-h-11 items-center rounded-full bg-primary px-5 py-3 text-sm font-bold text-primary-foreground hover:bg-primary/90 transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                                            >
                                                Scopri lo spettacolo
                                            </a>
                                        )}
                                        {event.data.googleMapsUrl && (
                                            <a
                                                href={event.data.googleMapsUrl}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="inline-flex min-h-11 items-center rounded-full border border-white/15 px-5 py-3 text-sm font-semibold text-foreground hover:border-primary/50 hover:text-blue-400 transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                                            >
                                                Mappa
                                            </a>
                                        )}
                                        </div>
                                    </div>
                                </article>
                                );
                            })}
                        </div>
                    ) : (
                        <div class="rounded-3xl border border-white/10 bg-white/4 p-8 text-muted-foreground">
                            Non ci sono ancora eventi pubblici in calendario.
                        </div>
                    )
                }
            </section>

            {
                pastEvents.length > 0 && (
                    <section>
                        <div class="flex items-center gap-4 mb-8">
                            <span class="h-px w-10 bg-white/20"></span>
                            <h2 class="text-sm font-bold uppercase tracking-[0.25em] text-muted-foreground">
                                Archivio
                            </h2>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            {pastEvents.slice(0, 8).map((event) => {
                                const show = showsByTitle.get(normalizeTitle(event.data.spettacolo));
                                return (
                                <article class="flex items-center gap-5 rounded-2xl border border-white/10 bg-white/3 p-5">
                                    {show?.image && (
                                        <img
                                            src={show.image.src}
                                            srcset={show.image.srcset}
                                            sizes="80px"
                                            alt=""
                                            width={show.image.width}
                                            height={show.image.height}
                                            loading="lazy"
                                            decoding="async"
                                            class="h-20 w-20 shrink-0 rounded-2xl object-cover opacity-70"
                                        />
                                    )}
                                    <div class="min-w-0">
                                    <div class="text-xs font-bold uppercase tracking-widest text-blue-400 mb-2">
                                        {formatDate(event.data.date)}
                                    </div>
                                    <h3 class="text-xl font-serif font-bold wrap-break-word">{event.data.spettacolo}</h3>
                                    <p class="text-sm text-muted-foreground mt-2">
                                        {event.data.venue}, {event.data.city}
                                    </p>
                                    </div>
                                </article>
                                );
                            })}
                        </div>
                    </section>
                )
            }
        </div>
    </div>
</Layout>
