---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import EventList from "../components/custom/EventList.astro";
import { getCalendarEvents } from "../lib/events";
import { splitEventsByDate } from "../lib/calendar-dates";

const { upcomingEvents, pastEvents } = splitEventsByDate(await getCalendarEvents());

const dateFormatter = new Intl.DateTimeFormat("it-IT", {
    timeZone: "Europe/Rome",
    weekday: "long",
    day: "2-digit",
    month: "long",
    year: "numeric",
});
const sectionTitle = "mb-10 text-[clamp(1.25rem,3vw,2.5rem)] uppercase leading-none tracking-[0.02em]";
---

<Layout
    title="Calendario | Sergio Procopio"
    description="Calendario ufficiale degli spettacoli, del corso di teatro e degli eventi di Sergio Procopio."
>
    <div class="container mx-auto min-h-screen px-4 pb-24 pt-36 md:px-8 lg:px-12">
        <header class="mb-20 max-w-4xl">
            <h1 class="text-[clamp(2.75rem,8vw,7rem)] uppercase leading-[0.92]">Calendario ufficiale</h1>
            <p class="mt-6 max-w-2xl text-lg font-light leading-relaxed text-muted-foreground lg:text-xl">
                Date pubbliche degli spettacoli e del corso di teatro in programma.
            </p>
        </header>

        <section class="mb-24" aria-labelledby="upcoming-title">
            <h2 id="upcoming-title" class={sectionTitle}>Prossimi eventi</h2>
            {
                upcomingEvents.length > 0 ? (
                    <EventList events={upcomingEvents} />
                ) : (
                    <p class="border-y border-border py-8 font-light text-muted-foreground">
                        Non ci sono ancora eventi pubblici in calendario.
                    </p>
                )
            }
        </section>

        {
            pastEvents.length > 0 && (
                <section aria-labelledby="archive-title">
                    <h2 id="archive-title" class={`${sectionTitle} text-muted-foreground`}>Archivio</h2>
                    <ul class="grid grid-cols-1 gap-x-12 md:grid-cols-2">
                        {pastEvents.slice(0, 8).map((event) => (
                            <li class="flex items-center gap-5 border-t border-border py-6">
                                {event.image && (
                                    <Image
                                        src={event.image}
                                        alt=""
                                        width={160}
                                        height={160}
                                        widths={[160, 320]}
                                        sizes="80px"
                                        fit="cover"
                                        format="webp"
                                        quality={70}
                                        loading="lazy"
                                        class="size-20 shrink-0 object-cover opacity-70"
                                    />
                                )}
                                <div class="min-w-0">
                                <p class="text-xs font-medium uppercase tracking-[0.16em] text-primary-soft">
                                    {dateFormatter.format(event.data.date)}
                                </p>
                                <h3 class="mt-2 text-xl wrap-break-word">{event.data.name}</h3>
                                <p class="mt-1 text-sm font-light text-muted-foreground">
                                    {event.data.venue}, {event.data.city}
                                </p>
                                </div>
                            </li>
                        ))}
                    </ul>
                </section>
            )
        }
    </div>
</Layout>
