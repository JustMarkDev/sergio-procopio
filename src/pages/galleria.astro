---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

// Mappiamo gli spettacoli per poter risalire al titolo dalla cartella
const spettacoli = await getCollection("spettacoli");
const showsMap = new Map(spettacoli.map((show) => [show.id, show.data.title]));

// Carichiamo tutte le immagini dalla cartella spettacoli
const allImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/spettacoli/**/*.{jpeg,jpg,png,gif,webp}",
    { eager: true },
);

// Convertiamo l'oggetto in un array e estraiamo i metadati
const galleryImages = Object.entries(allImages).map(([path, img]) => {
    const parts = path.split("/");
    const fileName = parts[parts.length - 1].split(".")[0];
    const showId = parts[parts.length - 2];
    const showTitle = showsMap.get(showId) || "Spettacolo Teatrale";

    return {
        src: img.default,
        alt: `${showTitle} - ${fileName}`,
        title: showTitle,
        subtitle: fileName,
    };
});
---

<Layout
    title="Galleria | Sergio Procopio"
    description="Scopri le immagini dei momenti più emozionanti degli spettacoli teatrali di Sergio Procopio."
>
    <div class="relative overflow-hidden bg-[#09090b] min-h-screen">
        {/* Background Aurora */}
        <div
            class="absolute top-0 left-0 w-full h-[50vh] bg-[radial-gradient(ellipse_at_top,rgba(37,99,235,0.05)_0%,transparent_70%)] pointer-events-none"
        >
        </div>

        <div class="w-full px-6 md:px-12 py-32 relative z-10 mx-auto">
            <div class="max-w-4xl mx-auto text-center mb-20">
                <div class="animate-fade-in">
                    <h1
                        class="text-5xl md:text-7xl font-serif font-bold mb-6 tracking-tight"
                    >
                        Galleria <span class="italic text-primary"
                            >Emozionale</span
                        >
                    </h1>
                    <p
                        class="text-xl text-muted-foreground font-serif italic max-w-2xl mx-auto opacity-80"
                    >
                        "Un'immagine vale più di mille parole, specialmente
                        quando il silenzio è il protagonista sul palcoscenico."
                    </p>
                </div>
            </div>

            {/* Masonry Columns Gallery - Expanded width */}
            {
                galleryImages.length > 0 ? (
                    <div class="columns-1 md:columns-2 lg:columns-3 gap-8 space-y-8 max-w-[1800px] mx-auto">
                        {galleryImages.map((image, index) => (
                            <div class="relative group overflow-hidden rounded-2xl bg-white/5 border border-white/10 break-inside-avoid shadow-lg">
                                <Image
                                    src={image.src}
                                    alt={image.alt}
                                    loading={index < 2 ? "eager" : "lazy"}
                                    decoding="async"
                                    fetchpriority={index === 0 ? "high" : undefined}
                                    class="w-full h-auto object-contain transition-all duration-700 group-hover:scale-105 group-hover:opacity-60"
                                />

                                {/* Overlay Gradient */}
                                <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none flex flex-col justify-end p-6">
                                    <h3 class="text-white font-serif font-bold text-xl transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                                        {image.title}
                                    </h3>
                                    <p class="text-white/70 text-sm italic capitalize transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 delay-75">
                                        {image.subtitle}
                                    </p>
                                </div>
                                {/* Subtle corner tag for mobile context if needed, but the hover overlay is better */}
                            </div>
                        ))}
                    </div>
                ) : (
                    <div class="text-center py-20 bg-white/5 border border-white/10 rounded-3xl max-w-4xl mx-auto">
                        <p class="text-xl font-serif text-muted-foreground">
                            La galleria è momentaneamente vuota.
                        </p>
                        <p class="text-sm text-muted-foreground/60 mt-2">
                            Aggiungi delle immagini nelle cartelle
                            src/assets/spettacoli/[nome-spettacolo]/ per vederle
                            apparire qui.
                        </p>
                    </div>
                )
            }
        </div>
    </div>
</Layout>
