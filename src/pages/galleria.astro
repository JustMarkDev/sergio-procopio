---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import GalleryView from "../components/custom/GalleryView";
import { getImageTitleFromPath } from "../lib/show-assets";

const spettacoli = await getCollection("spettacoli");

const galleryImagesFromShows = spettacoli
    .filter((show) => !show.data.draft)
    .flatMap((show) =>
        show.data.galleryImages.map((image, index) => ({
            src: image,
            alt: `${show.data.title} - immagine ${index + 1}`,
            showId: show.id,
            title: show.data.title,
            subtitle: getImageTitleFromPath(image.src) || `immagine ${index + 1}`,
            width: image.width,
            height: image.height,
        })),
    );

const galleryImagesBySource = new Map<string, (typeof galleryImagesFromShows)[number]>();
for (const image of galleryImagesFromShows) {
    galleryImagesBySource.set(image.src.src, image);
}
const allGalleryImages = Array.from(galleryImagesBySource.values());

// Ottimizziamo tutte le immagini lato server in parallelo prima di passarle a React
const galleryImages = await Promise.all(
    allGalleryImages.map(async (image) => {
        // 1. Immagine grande per lightbox (1200px)
        const optimizedLarge = await getImage({
            src: image.src,
            width: 1200,
            format: "webp",
            quality: 80,
        });

        // 2. Immagine media per la griglia masonry (600px)
        const optimizedGrid = await getImage({
            src: image.src,
            width: 600,
            format: "webp",
            quality: 75,
        });

        // 3. Miniatura molto piccola per le anteprime (120px)
        const optimizedThumb = await getImage({
            src: image.src,
            width: 120,
            height: 120,
            format: "webp",
            quality: 60,
        });

        return {
            src: optimizedLarge.src,
            gridSrc: optimizedGrid.src,
            thumbSrc: optimizedThumb.src,
            originalSrc: image.src.src,
            alt: image.alt,
            showId: image.showId,
            title: image.title,
            subtitle: image.subtitle,
            width: image.width,
            height: image.height,
        };
    })
);

---

<Layout
    title="Galleria | Sergio Procopio"
    description="Scopri le immagini dei momenti più emozionanti degli spettacoli teatrali di Sergio Procopio."
>
    <div class="relative overflow-hidden bg-background min-h-screen">
        <div class="container relative z-10 mx-auto px-4 md:px-8 lg:px-12 py-32">
            <div class="max-w-4xl mx-auto text-center mb-20">
                <div>
                    <h1
                        class="text-5xl md:text-7xl font-serif font-bold mb-6 tracking-tight"
                    >
                        <span
                            class="inline-block align-bottom overflow-hidden pb-[0.12em] -mb-[0.12em]"
                            ><span class="riga-ribalta inline-block"
                                >Galleria</span
                            ></span
                        >{" "}<span
                            class="inline-block align-bottom overflow-hidden pb-[0.12em] -mb-[0.12em]"
                            ><span
                                class="riga-ribalta riga-ribalta--battuta inline-block italic text-primary"
                                >Emozionale</span
                            ></span
                        >
                    </h1>
                    <p
                        class="citazione-scena text-xl text-muted-foreground italic max-w-2xl mx-auto opacity-80"
                    >
                        "Un'immagine vale più di mille parole, specialmente
                        quando il silenzio è il protagonista sul palcoscenico."
                    </p>
                </div>
            </div>

            {/* Masonry Columns Gallery - Expanded width */}
            {
                galleryImages.length > 0 ? (
                    <GalleryView client:visible images={galleryImages} />
                ) : (
                    <div class="text-center py-20 bg-white/5 border border-border rounded-3xl max-w-4xl mx-auto">
                        <p class="text-xl text-muted-foreground">
                            La galleria è momentaneamente vuota.
                        </p>
                        <p class="text-sm text-muted-foreground/60 mt-2">
                            Aggiungi delle immagini nelle cartelle
                            dal campo Immagini galleria di uno spettacolo per
                            vederle apparire qui.
                        </p>
                    </div>
                )
            }
        </div>
    </div>
</Layout>

<style>
    /* GALLERIA — il foyer: velo del proiettore, titolo in ribalta con la
       pausa della battuta, citazione che si posa. Time-based (hero above the
       fold), solo transform+opacity, EASE del sistema duplicato in CSS.
       Guardia reduced-motion: fuori dalla guardia nessuno stato nascosto. */
    @keyframes ribalta-sale {
        from {
            opacity: 0;
            transform: translateY(110%);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @keyframes citazione-posa {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @media (prefers-reduced-motion: no-preference) {
        .riga-ribalta {
            animation: ribalta-sale 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.05s
                both;
        }
        /* La battuta corsiva oro entra UNA PAUSA_BATTUTA (0.18s) dopo il setup. */
        .riga-ribalta--battuta {
            animation-delay: 0.23s;
        }
        .citazione-scena {
            animation: citazione-posa 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.35s
                both;
        }
    }
</style>
