---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/custom/HeroSection";
import FeaturedShows from "../components/custom/FeaturedShows";
import ContactCTA from "../components/custom/ContactCTA.astro";
import EventList from "../components/custom/EventList.astro";
import { getCollection } from "astro:content";
import { getCalendarEvents } from "../lib/events";
import { splitEventsByDate } from "../lib/calendar-dates";
import { getImage } from "astro:assets";
import socialImage from "../../public/social.jpg";

const heroImage = await getImage({
    src: socialImage,
    width: 1476,
    height: 984,
    widths: [640, 960, 1280, 1476],
    format: "webp",
    quality: 85,
});

const allShows = (await getCollection("spettacoli")).filter(
    (show) => !show.data.draft,
);
// Highlighted shows come first.
const featuredShows = await Promise.all(allShows
    .sort((a, b) => (b.data.highlight ? 1 : 0) - (a.data.highlight ? 1 : 0))
    .map(async (show) => {
        const image = show.data.image ? await getImage({
            src: show.data.image,
            width: 1500,
            height: 1000,
            widths: [640, 1000, 1500],
            fit: "cover",
            format: "webp",
            quality: 70,
        }) : undefined;
        return {
            id: show.id,
            title: show.data.title,
            category: show.data.category,
            description: show.data.description,
            durata: show.data.durata,
            image: image ? {
                src: image.src,
                srcSet: image.srcSet.attribute,
                width: 1500,
                height: 1000,
            } : undefined,
        };
    }));

const { upcomingEvents } = splitEventsByDate(await getCalendarEvents());
const nextEvents = upcomingEvents.slice(0, 4);
---

<Layout>
    <HeroSection image={{ src: heroImage.src, srcSet: heroImage.srcSet.attribute, width: 1476, height: 984 }} />
    <FeaturedShows client:visible shows={featuredShows} />
    {nextEvents.length > 0 && (
        <section aria-labelledby="next-dates-title" class="container mx-auto px-4 py-24 md:px-8 lg:px-12 lg:py-36">
            <h2 id="next-dates-title" class="mb-10 text-[clamp(1.25rem,3vw,2.5rem)] uppercase leading-none tracking-[0.02em]">
                Prossime date
            </h2>
            <EventList events={nextEvents} compact />
            <a href="/calendario" class="mt-10 inline-block border-b border-primary-soft pb-1.5 text-xs font-medium uppercase tracking-[0.18em] text-primary-soft transition-colors hover:border-foreground hover:text-foreground">
                Calendario completo
            </a>
        </section>
    )}
    <ContactCTA />
</Layout>
