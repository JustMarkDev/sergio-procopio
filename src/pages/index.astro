---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/custom/HeroSection";
import FeaturedShows from "../components/custom/FeaturedShows";
import ContactForm from "../components/custom/ContactForm";
import { getCollection } from "astro:content";

const allShows = (await getCollection("spettacoli")).filter(
    (show) => !show.data.draft,
);
// Prefer highlighted shows or first 3
const featuredShows = allShows
    .sort((a, b) => (b.data.highlight ? 1 : 0) - (a.data.highlight ? 1 : 0))
    .slice(0, 3)
    .map((show) => ({
        id: show.id,
        title: show.data.title,
        category: show.data.category,
        description: show.data.description,
        durata: show.data.durata,
        image: show.data.image?.src, // Pass the resolved src URL to the React component
    }));
---

<Layout>
    <HeroSection />
    <FeaturedShows shows={featuredShows} />
    <ContactForm client:load />
</Layout>
