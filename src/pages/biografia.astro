---
import Layout from "../layouts/Layout.astro";
import { Image, getImage } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import { ordinaPerHome } from "../lib/home-catalogo";

const biografia = await getEntry("pages", "biografia");

if (!biografia) {
    throw new Error("Biografia content entry not found.");
}

const { Content } = await render(biografia);

// La striscia di foto va DOPO la sezione «Trionfo sullo schermo»: si spezza
// l'HTML renderizzato all'apertura della sezione successiva. Se il titolo
// cambiasse e il marcatore non si trovasse più, tutto il testo resta nella
// prima metà e le foto scivolano in fondo: niente contenuto perso.
const htmlBiografia = biografia.rendered?.html ?? "";
const marcatoreSplit = '<h2 id="presenza-costante';
const posizioneSplit = htmlBiografia.indexOf(marcatoreSplit);

// I titoli della prosa arrivano da `set:html`: non si possono aggiungere
// classi nei file .md, quindi la maschera del mask reveal («il titolo sale
// in ribalta») si avvolge qui, direttamente sulla stringa HTML renderizzata.
// Wrapper puramente presentazionale: copy, id e attributi dell'h2 intatti.
const avvolgiTitoli = (html: string) =>
    html.replace(
        /(<h2\b[^>]*>)([\s\S]*?)(<\/h2>)/g,
        (_, apre, contenuto, chiude) =>
            `${apre}<span class="maschera-titolo"><span class="riga-titolo">${contenuto}</span></span>${chiude}`,
    );

const proseParte1 = avvolgiTitoli(
    posizioneSplit === -1 ? htmlBiografia : htmlBiografia.slice(0, posizioneSplit),
);
const proseParte2 = avvolgiTitoli(
    posizioneSplit === -1 ? "" : htmlBiografia.slice(posizioneSplit),
);

const classiProse =
    "prosa-scena space-y-16 [&_h2]:text-3xl [&_h2]:md:text-4xl [&_h2]:font-serif [&_h2]:font-semibold [&_h2]:text-transparent [&_h2]:bg-clip-text [&_h2]:bg-[linear-gradient(to_bottom,#e8b44a,#c9a227)] [&_h2]:pb-2 [&_h2]:mt-24 [&_h2:first-child]:mt-0 [&_h2]:mb-6 [&_p]:text-lg [&_p]:text-white/80 [&_p]:leading-relaxed [&_p]:max-w-4xl [&_p]:mb-4";

// Tappe principali della carriera (già nella sezione «Chi sono» della home,
// oggi vive solo qui). Ogni anno resta un <time> a sé anche quando la voce
// ne raggruppa due.
interface Tappa {
    anni: string[];
    testo: string;
}

const tappe: Tappa[] = [
    {
        anni: ["1975"],
        testo: "Entra nel collegio dei Salesiani di Arese, a undici anni.",
    },
    {
        anni: ["1977"],
        testo: "Nasce la compagnia «I Barabba's Clown».",
    },
    {
        anni: ["1989"],
        testo: "Vaticano, davanti a Giovanni Paolo II.",
    },
    {
        anni: ["1990"],
        testo: "Nasce la Compagnia Teatrale Sergio Procopio, con la regia di Carlo Rossi.",
    },
    {
        anni: ["1993", "1996"],
        testo: "Festival Internazionale del Clown di Milano; al Festival Internazionale del Riso di Bordighera è il più applaudito.",
    },
    {
        anni: ["2006"],
        testo: "Venticinque anni di carriera al Piccolo Teatro Studio di Milano; e il Perù, al teatro Museo della Nazione, davanti al Presidente della Repubblica.",
    },
    {
        anni: ["2020"],
        testo: "Il traguardo dei quarant'anni di attività.",
    },
];

// Numeri di carriera, tutti documentati nel sito: niente cifre inventate.
// I numeri sono stampati al valore finale in SSR (fallback senza JS e con
// reduced motion); con JS parte il count-up rapido 0→valore (vedi <script>).
interface Numero {
    valore: number;
    suffisso: string;
    etichetta: string;
}

const numeri: Numero[] = [
    { valore: 40, suffisso: "+", etichetta: "anni di palcoscenico" },
    { valore: 18, suffisso: "", etichetta: "spettacoli scritti e in scena" },
    { valore: 2000, suffisso: "+", etichetta: "repliche con la compagnia" },
    { valore: 8, suffisso: "", etichetta: "paesi nel mondo" },
];

const formatoIt = new Intl.NumberFormat("it-IT", { useGrouping: "always" });

// Foto di scena per spezzare il racconto: le prime del repertorio, già
// nell'ordine editoriale della home.
const spettacoliConFoto = ordinaPerHome(
    (await getCollection("spettacoli")).filter(
        (show) => !show.data.draft && show.data.image,
    ),
);

const fotoStrip = await Promise.all(
    spettacoliConFoto.slice(0, 3).map(async (show) => {
        const ottimizzata = await getImage({
            src: show.data.image!,
            widths: [480, 720],
            format: "webp",
            quality: 75,
        });
        return {
            src: ottimizzata.src,
            srcset: ottimizzata.srcSet.attribute,
            width: show.data.image!.width,
            height: show.data.image!.height,
            titolo: show.data.title,
            href: `/spettacoli/${show.id}`,
        };
    }),
);

---

<Layout
    title={`${biografia.data.title} | Sergio Procopio`}
    description={biografia.data.description}
>
    <div class="relative overflow-hidden bg-background min-h-screen text-white">
        {/* Background Gradients — solo l'orba oro si accende al load (luce di
            sala, sola opacity): il rosso resta superficie, mai animato */}
        <div class="luce-sala absolute top-0 -right-[10%] w-[50vw] h-[60vh] bg-primary/10 rounded-full blur-[150px] pointer-events-none"></div>
        {/* Fermo nello sfondo della pagina. Sollevato dal fondo e dimensionato
            sullo schermo (vw/vh), così il bagliore si spegne prima del footer
            e non finisce mai tagliato. */}
        <div class="absolute bottom-32 -left-[10%] w-[50vw] h-[60vh] bg-[#c2273d]/10 rounded-full blur-[150px] pointer-events-none"></div>

        <div class="container relative z-10 mx-auto px-4 md:px-8 lg:px-12 py-32">
            {/* Hero Section */}
            <div class="flex flex-col lg:flex-row gap-16 items-center mb-24">
                <div class="lg:w-1/2 space-y-8">
                    {/* pb in em (compensato dal -mb): con leading-[0.9] il
                        discendente della «g» esce dalla line box e senza
                        questo margine la maschera overflow-hidden lo taglia. */}
                    <h1 class="overflow-hidden text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-serif font-bold tracking-tighter leading-[0.9] pb-[0.2em] -mb-[0.1em]">
                        <span class="riga-ribalta block">{biografia.data.title}</span>
                    </h1>
                    <div class="filo-oro-hero w-20 h-1 bg-primary/50 rounded-full"></div>
                    {
                        biografia.data.quote && (
                            <p class="battuta-hero text-2xl md:text-3xl font-serif text-muted-foreground italic opacity-90 leading-relaxed border-l-2 border-primary/30 pl-6 py-2">
                                "{biografia.data.quote}"
                            </p>
                        )
                    }
                </div>

                {
                    biografia.data.image && (
                        <div class="lg:w-1/2 w-full relative">
                            {/* 8:9 invece di 4:5: ritratto leggermente più basso. */}
                            <div class="ritratto-scena aspect-8/9 rounded-3xl overflow-hidden relative border border-white/10 bg-white/5">
                                <Image
                                    src={biografia.data.image}
                                    alt="Ritratto di Sergio Procopio"
                                    loading="eager"
                                    class="absolute inset-0 w-full h-full object-cover"
                                />
                                <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent"></div>
                            </div>
                        </div>
                    )
                }
            </div>

            {/* I numeri — i cartelli dei numeri si sollevano scaglionati allo scroll */}
            <div class="mb-24 grid grid-cols-2 gap-6 rounded-4xl border border-white/10 bg-[var(--card)] p-8 md:p-10 lg:grid-cols-4">
                {
                    numeri.map((numero) => (
                        <div class="cartello-numero">
                            <p class="font-serif text-[clamp(2.25rem,4.5vw,3.5rem)] font-bold leading-none tabular-nums">
                                <span
                                    aria-hidden="true"
                                    class="inline-block bg-linear-to-b from-[#e8b44a] to-[#c9a227] bg-clip-text text-transparent [-webkit-background-clip:text]"
                                >
                                    <span data-contatore={numero.valore}>
                                        {formatoIt.format(numero.valore)}
                                    </span>
                                    {numero.suffisso}
                                </span>
                                <span class="sr-only">
                                    {formatoIt.format(numero.valore)}
                                    {numero.suffisso}
                                </span>
                            </p>
                            <p class="mt-3 text-sm leading-relaxed text-white/70">
                                {numero.etichetta}
                            </p>
                        </div>
                    ))
                }
            </div>

            {/* Le tappe — linea del tempo, prima parte della sezione «Chi sono» della home */}
            <section aria-labelledby="tappe-title" class="mb-24">
                <div class="mb-6 flex items-center gap-4">
                    <span aria-hidden="true" class="filo-kicker h-px w-10 shrink-0 bg-primary/40"></span>
                    <span class="kicker-scena text-[11px] font-bold uppercase tracking-[0.25em] text-primary md:text-xs">
                        Le tappe
                    </span>
                </div>
                <h2
                    id="tappe-title"
                    class="mb-12 max-w-3xl font-serif text-3xl font-bold leading-tight tracking-tight md:text-4xl"
                >
                    {/* Wrapper puramente presentazionale (maschera del mask
                        reveal): copy, id e aria dell'h2 restano intatti. */}
                    <span class="block overflow-hidden pb-[0.12em] -mb-[0.12em]">
                        <span class="riga-tappe block">
                            Entrato in collegio a undici anni. Uscito{" "}
                            <span class="battuta-tappe inline-block italic text-primary">clown</span>.
                        </span>
                    </span>
                </h2>

                {/* Da mobile la timeline è verticale (bordo a sinistra); da
                    desktop (lg) diventa orizzontale, con la linea al centro e
                    le tappe che si alternano sopra e sotto. */}
                <ol class="relative border-l border-white/15 lg:flex lg:gap-4 lg:border-l-0">
                    {/* Linea base orizzontale, solo desktop. */}
                    <span
                        aria-hidden="true"
                        class="hidden lg:block absolute left-0 top-1/2 h-px w-full bg-white/15"
                    ></span>
                    {/* Il filo del tempo: la luce d'oro sovrapposta al bordo
                        scorre lungo la timeline man mano che si legge; senza
                        supporto scroll-driven resta accesa per intero e il
                        bordo bianco sotto garantisce comunque la struttura.
                        Su desktop scorre in orizzontale (vedi media query
                        nello <style>). */}
                    <span
                        aria-hidden="true"
                        class="filo-tempo absolute -left-px top-0 h-full w-px origin-top bg-linear-to-b from-[#e8b44a] to-[#c9a227] lg:left-0 lg:top-1/2 lg:h-px lg:w-full lg:origin-left lg:bg-linear-to-r"
                    ></span>
                    {
                        tappe.map((tappa, indice) => (
                            <li class="tappa-scena relative list-none pb-8 pl-8 last:pb-0 lg:grid lg:flex-1 lg:grid-rows-[1fr_1fr] lg:px-2 lg:pb-0 lg:pl-2">
                                {/* Il pallino viaggia col cartello della tappa
                                    (nessuna regola propria): un solo
                                    transform-owner per elemento — il suo
                                    -translate-x-1/2 resta intoccato. Su
                                    desktop si centra sulla linea orizzontale. */}
                                <span
                                    aria-hidden="true"
                                    class="absolute left-0 top-[0.6rem] h-[11px] w-[11px] -translate-x-1/2 rounded-full border-2 border-primary bg-primary lg:left-1/2 lg:top-1/2 lg:-translate-y-1/2"
                                />
                                {/* Alternanza desktop: tappe pari sopra la
                                    linea (allineate in basso), dispari sotto
                                    (allineate in alto). Su mobile il wrapper
                                    è trasparente. */}
                                <div
                                    class={
                                        indice % 2 === 0
                                            ? "lg:row-start-1 lg:self-end lg:pb-7 lg:text-center"
                                            : "lg:row-start-2 lg:self-start lg:pt-7 lg:text-center"
                                    }
                                >
                                    <p class="font-serif text-xl text-primary">
                                        {tappa.anni.map((anno, i) => (
                                            <Fragment>
                                                {i > 0 ? " e " : null}
                                                <time datetime={anno}>{anno}</time>
                                            </Fragment>
                                        ))}
                                    </p>
                                    <p class="mt-1 max-w-[68ch] text-sm leading-relaxed text-white/70 lg:mx-auto">
                                        {tappa.testo}
                                    </p>
                                </div>
                            </li>
                        ))
                    }
                </ol>
            </section>

            {
                htmlBiografia ? (
                    <Fragment>
                        <div class={classiProse} set:html={proseParte1} />

                        {/* Foto di scena dopo «Trionfo sullo schermo»:
                            spezzano il racconto e portano al repertorio */}
                        <div class="my-16 grid grid-cols-1 gap-6 sm:grid-cols-3 md:my-20 md:gap-8">
                            {fotoStrip.map((foto) => (
                                <a
                                    href={foto.href}
                                    aria-label={`Scheda di ${foto.titolo}`}
                                    class="locandina-scena group relative aspect-4/5 overflow-hidden rounded-3xl border border-white/10 bg-white/5"
                                >
                                    <img
                                        src={foto.src}
                                        srcset={foto.srcset}
                                        sizes="(min-width: 640px) 33vw, 100vw"
                                        alt={`Foto di scena di «${foto.titolo}»`}
                                        width={foto.width}
                                        height={foto.height}
                                        loading="lazy"
                                        decoding="async"
                                        class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                                    />
                                    <div
                                        aria-hidden="true"
                                        class="absolute inset-0 bg-linear-to-t from-black/70 via-transparent to-transparent"
                                    />
                                    <p class="absolute inset-x-5 bottom-4 font-serif text-xl font-bold text-white">
                                        «{foto.titolo}»
                                    </p>
                                </a>
                            ))}
                        </div>

                        {proseParte2 && (
                            <div class={classiProse} set:html={proseParte2} />
                        )}
                    </Fragment>
                ) : (
                    <div class={classiProse}>
                        <Content />
                    </div>
                )
            }

            {/* Firma — l'inchino finale: la firma sale in ribalta dentro la
                sua maschera, il ruolo la segue un battito dopo */}
            <div class="mt-24 border-t border-white/10 pt-12">
                <span class="block overflow-hidden pb-[0.12em] -mb-[0.12em]">
                    <p class="firma-riga font-serif text-3xl italic text-primary">Sergio Procopio</p>
                </span>
                <p class="firma-ruolo mt-2 text-[11px] uppercase tracking-[0.2em] text-white/60">
                    attore, mimo e clown{" "}
                    <span aria-hidden="true" class="text-primary">·</span>{" "}
                    Teatro Procopio
                </p>
            </div>
        </div>
    </div>
</Layout>

<script>
    // Count-up rapido dei numeri: da 0 al valore finale quando la fascia
    // entra in viewport. I valori pieni sono già in SSR (e nel fratello
    // sr-only per gli screen reader): senza JavaScript o con reduced motion
    // non si muove nulla e restano quelli.
    const DURATA_CONTEGGIO_MS = 800;

    const avviaConteggi = () => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        const contatori =
            document.querySelectorAll<HTMLElement>("[data-contatore]");
        if (contatori.length === 0) return;

        const formato = new Intl.NumberFormat("it-IT", {
            useGrouping: "always",
        });

        const anima = (nodo: HTMLElement) => {
            const finale = Number(nodo.dataset.contatore ?? "0");
            const inizio = performance.now();
            const passo = (adesso: number) => {
                const t = Math.min((adesso - inizio) / DURATA_CONTEGGIO_MS, 1);
                // Ease-out cubico: corre subito e si posa sul valore finale.
                const eased = 1 - Math.pow(1 - t, 3);
                nodo.textContent = formato.format(Math.round(finale * eased));
                if (t < 1) requestAnimationFrame(passo);
            };
            requestAnimationFrame(passo);
        };

        const osservatore = new IntersectionObserver(
            (voci) => {
                for (const voce of voci) {
                    if (!voce.isIntersecting) continue;
                    anima(voce.target as HTMLElement);
                    osservatore.unobserve(voce.target);
                }
            },
            { threshold: 0.4 },
        );
        contatori.forEach((nodo) => osservatore.observe(nodo));
    };

    // astro:page-load copre sia il primo caricamento sia le navigazioni del
    // ClientRouter (che rimonta il DOM della pagina).
    document.addEventListener("astro:page-load", avviaConteggi);
</script>

<style>
    /* ============================================================
       SIPARIO — il filo del tempo (biografia)

       I tre tempi del numero: (1) LA LUCE SI ACCENDE — l'orba oro
       dell'hero sale di sola opacity e i fili d'oro si disegnano
       (scaleX/scaleY, mai width); (2) I TITOLI SALGONO IN RIBALTA
       dentro maschere overflow-hidden (mai fade-up sui titoli
       protagonisti); (3) GLI ELEMENTI PRENDONO IL PALCO — cartelli
       dei numeri, tappe e locandine entrano scaglionati.

       L'hero è a tempo (keyframe CSS al load, JS non necessario,
       solo media query no-preference); tutto il resto è
       scroll-driven con animation-timeline: view() dietro DOPPIA
       GUARDIA @supports + no-preference: fuori dalle guardie
       nessuna regola nasconde nulla, quindi no-JS, reduced motion
       e browser senza supporto vedono la pagina piena e ferma.
       Solo transform+opacity; EASE del sistema duplicato come
       cubic-bezier(0.16, 1, 0.3, 1); durate solo DUR (0.25/0.35/
       0.55/0.9s); PAUSA_BATTUTA = 0.18s a tempo, +12% di
       animation-range nell'equivalente scroll-driven; tetto 1.6s.
       ============================================================ */

    /* ---- HERO: la luce si accende (a tempo, al load) ---- */
    @keyframes luce-sala-accendi {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
    @keyframes riga-ribalta-su {
        from {
            transform: translateY(110%);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
    @keyframes filo-hero-disegna {
        from {
            transform: scaleX(0);
            opacity: 0;
        }
        to {
            transform: scaleX(1);
            opacity: 1;
        }
    }
    @keyframes battuta-hero-entra {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @keyframes ritratto-posa {
        from {
            opacity: 0;
            transform: translateY(18px) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        /* L'orba è uno strato pre-dipinto: si accende in sola opacity. */
        .luce-sala {
            animation: luce-sala-accendi 0.9s cubic-bezier(0.16, 1, 0.3, 1)
                both;
        }
        /* Il titolo sale in ribalta dentro l'h1 overflow-hidden. */
        .riga-ribalta {
            animation: riga-ribalta-su 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.1s
                both;
        }
        /* Il filo d'oro si disegna mentre il titolo sale. */
        .filo-oro-hero {
            transform-origin: left;
            animation: filo-hero-disegna 0.55s cubic-bezier(0.16, 1, 0.3, 1)
                0.35s both;
        }
        /* La pausa della battuta: delay = 0.35s (filo) + 0.18s
           PAUSA_BATTUTA = 0.53s. */
        .battuta-hero {
            animation: battuta-hero-entra 0.55s cubic-bezier(0.16, 1, 0.3, 1)
                0.53s both;
        }
        /* Ultimo elemento a finire: 0.2 + 0.9 = 1.1s < 1.6s (tetto). */
        .ritratto-scena {
            animation: ritratto-posa 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.2s
                both;
        }
    }

    /* ---- Scroll-driven: keyframes (inerti fuori dalle guardie) ---- */
    @keyframes cartello-numero-su {
        from {
            opacity: 0;
            transform: translateY(24px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @keyframes filo-kicker-accendi {
        from {
            transform: scaleX(0);
        }
        to {
            transform: scaleX(1);
        }
    }
    @keyframes kicker-scena-entra {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
    @keyframes riga-tappe-su {
        from {
            transform: translateY(110%);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
    @keyframes battuta-tappe-entra {
        from {
            opacity: 0;
            transform: translateY(0.35em);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @keyframes filo-tempo-scorri {
        from {
            transform: scaleY(0);
        }
        to {
            transform: scaleY(1);
        }
    }
    /* Variante desktop: la timeline è orizzontale, il filo si disegna
       da sinistra (inerte fuori dalle guardie, come gli altri). */
    @keyframes filo-tempo-scorri-x {
        from {
            transform: scaleX(0);
        }
        to {
            transform: scaleX(1);
        }
    }
    @keyframes tappa-scena-su {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @keyframes locandina-scena-su {
        from {
            opacity: 0;
            transform: translateY(24px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @keyframes firma-riga-su {
        from {
            transform: translateY(110%);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
    @keyframes firma-ruolo-entra {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
            /* Fascia numeri: cartelli scaglionati per colonna (passo +8%,
               come i .cartello-scena di globals.css); innocuo anche sulla
               griglia a 2 colonne mobile, le coppie entrano a passi
               alternati. */
            .cartello-numero {
                animation: cartello-numero-su cubic-bezier(0.16, 1, 0.3, 1)
                    both;
                animation-timeline: view();
                animation-range: entry 0% entry 55%;
            }
            .cartello-numero:nth-child(2) {
                animation-range: entry 8% entry 63%;
            }
            .cartello-numero:nth-child(3) {
                animation-range: entry 16% entry 71%;
            }
            .cartello-numero:nth-child(4) {
                animation-range: entry 24% entry 79%;
            }

            /* Kicker delle tappe: il trattino si accende come un filo di
               luce, il testo lo segue. */
            .filo-kicker {
                transform-origin: left;
                animation: filo-kicker-accendi cubic-bezier(0.16, 1, 0.3, 1)
                    both;
                animation-timeline: view();
                animation-range: entry 0% entry 40%;
            }
            .kicker-scena {
                animation: kicker-scena-entra cubic-bezier(0.16, 1, 0.3, 1)
                    both;
                animation-timeline: view();
                animation-range: entry 8% entry 48%;
            }

            /* Il titolo delle tappe sale in ribalta dentro la maschera. */
            .riga-tappe {
                animation: riga-tappe-su cubic-bezier(0.16, 1, 0.3, 1) both;
                animation-timeline: view();
                animation-range: entry 0% entry 50%;
            }
            /* La pausa della battuta tradotta in range: +12% rispetto alla
               riga (PAUSA_BATTUTA, stesso passo dei +8/+16% dei cartelli).
               Figlio della riga mascherata: due transform-owner distinti,
               nessun conflitto. */
            .battuta-tappe {
                animation: battuta-tappe-entra cubic-bezier(0.16, 1, 0.3, 1)
                    both;
                animation-timeline: view();
                animation-range: entry 12% entry 62%;
            }

            /* IL FILO DEL TEMPO — firma della pagina: la luce d'oro SCORRE
               lungo la timeline man mano che si legge il racconto (scrub,
               non entrata secca). */
            .filo-tempo {
                animation: filo-tempo-scorri cubic-bezier(0.16, 1, 0.3, 1)
                    both;
                animation-timeline: view();
                animation-range: entry 0% cover 75%;
            }
            /* Da desktop la timeline è orizzontale: stesso scrub, asse X. */
            @media (min-width: 1024px) {
                .filo-tempo {
                    animation-name: filo-tempo-scorri-x;
                }
            }

            /* Le tappe: ogni li ha la propria timeline, lo scroll fa da
               stagger naturale sull'elenco verticale. Il pallino viaggia
               col cartello della tappa: un solo transform-owner per
               elemento, nessuna regola propria. */
            .tappa-scena {
                animation: tappa-scena-su cubic-bezier(0.16, 1, 0.3, 1) both;
                animation-timeline: view();
                animation-range: entry 0% entry 50%;
            }

            /* Strip foto: tre locandine sul palco, scaglionate per colonna.
               Il transform d'entrata vive sull'<a>; l'hover scale resta
               sull'<img>: transform-owner distinti. */
            .locandina-scena {
                animation: locandina-scena-su cubic-bezier(0.16, 1, 0.3, 1)
                    both;
                animation-timeline: view();
                animation-range: entry 0% entry 55%;
            }
            .locandina-scena:nth-child(2) {
                animation-range: entry 10% entry 65%;
            }
            .locandina-scena:nth-child(3) {
                animation-range: entry 20% entry 75%;
            }

            /* Firma — l'inchino finale: la firma sale in ribalta come un
               saluto. */
            .firma-riga {
                animation: firma-riga-su cubic-bezier(0.16, 1, 0.3, 1) both;
                animation-timeline: view();
                animation-range: entry 0% entry 60%;
            }
            /* +12% = PAUSA_BATTUTA in range: la pausa della battuta chiude
               la pagina. */
            .firma-ruolo {
                animation: firma-ruolo-entra cubic-bezier(0.16, 1, 0.3, 1)
                    both;
                animation-timeline: view();
                animation-range: entry 12% entry 72%;
            }
        }
    }
</style>

<style is:global>
    /* SIPARIO — prosa della biografia. Blocco is:global necessario: il
       contenuto arriva da `set:html` ed è fuori dallo scope di Astro; i
       selettori sono tutti ancorati a .prosa-scena, quindi specifici di
       questa pagina. La maschera dei titoli è layout neutro (non nasconde
       nulla) e vive FUORI dalle guardie; il gradiente bg-clip-text dell'h2
       continua a ritagliarsi sui glifi dei discendenti. */
    .prosa-scena .maschera-titolo {
        display: block;
        overflow: hidden;
        padding-bottom: 0.12em;
        margin-bottom: -0.12em;
    }
    .prosa-scena .riga-titolo {
