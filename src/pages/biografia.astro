            .prosa-scena .riga-titolo {
                animation: riga-titolo-su cubic-bezier(0.16, 1, 0.3, 1) both;
                animation-timeline: view();
                animation-range: entry 0% entry 55%;
            }
            /* Entrata discreta dei paragrafi: lo scroll scagliona da sé le
