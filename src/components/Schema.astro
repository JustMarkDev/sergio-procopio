---
import { jsonLd } from "../lib/json-ld";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, SOCIAL_LINKS } from '../consts';
import { CONTACT_NAP } from '../lib/contact-trust';

const contactPoint = {
  "@type": "ContactPoint",
  "contactType": "bookings and information",
  "email": CONTACT_NAP.email,
  "telephone": CONTACT_NAP.telephone,
  "url": `${CONTACT_NAP.url}${CONTACT_NAP.contactAliasPath}`,
  "availableLanguage": ["Italian", "English"]
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE_URL}/#person`,
  "name": CONTACT_NAP.name,
  "alternateName": ["Sergio Procopio mimo", "Sergio Procopio teatro"],
  "url": CONTACT_NAP.url,
  "image": `${SITE_URL}/og-image.jpg`,
  "description": SITE_DESCRIPTION,
  "jobTitle": "Attore, mimo e regista teatrale",
  "email": CONTACT_NAP.email,
  "telephone": CONTACT_NAP.telephone,
  "sameAs": [
    SOCIAL_LINKS.instagram,
    SOCIAL_LINKS.facebook,
    SOCIAL_LINKS.youtube
  ]
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE_URL}/#organization`,
  "name": CONTACT_NAP.name,
  "legalName": CONTACT_NAP.name,
  "url": CONTACT_NAP.url,
  "logo": `${SITE_URL}/favicon.svg`,
  "image": `${SITE_URL}/og-image.jpg`,
  "description": SITE_DESCRIPTION,
  "email": CONTACT_NAP.email,
  "telephone": CONTACT_NAP.telephone,
  "contactPoint": contactPoint,
  "founder": { "@id": `${SITE_URL}/#person` },
  "sameAs": [
    SOCIAL_LINKS.instagram,
    SOCIAL_LINKS.facebook,
    SOCIAL_LINKS.youtube
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  "url": CONTACT_NAP.url,
  "name": SITE_TITLE,
  "alternateName": CONTACT_NAP.name,
  "description": SITE_DESCRIPTION,
  "publisher": {
    "@id": `${SITE_URL}/#organization`
  },
  "about": {
    "@id": `${SITE_URL}/#person`
  },
  "inLanguage": "it-IT"
};
---

<script type="application/ld+json" is:inline set:html={jsonLd(personSchema)} />
<script type="application/ld+json" is:inline set:html={jsonLd(organizationSchema)} />
<script type="application/ld+json" is:inline set:html={jsonLd(websiteSchema)} />
