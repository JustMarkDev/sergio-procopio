---
import { splitEventsByDate } from "../../lib/calendar-dates";

interface Props {
    events: {
        data: {
            date: Date;
            time?: string;
            venue: string;
            city: string;
        };
    }[];
    limit?: number;
}

const { events, limit = 4 } = Astro.props;

const { upcomingEvents } = splitEventsByDate(events);

const eventDateFormatter = new Intl.DateTimeFormat("it-IT", {
    timeZone: "Europe/Rome",
    weekday: "long",
    day: "2-digit",
    month: "long",
});
---

{upcomingEvents.length > 0 && (
    <div class="mt-10 border-t border-border pt-8">
        <h2 class="mb-4 text-[11px] uppercase tracking-[0.2em] text-muted-foreground">
            Prossime date
        </h2>
        <ul class="space-y-4">
            {upcomingEvents.slice(0, limit).map((event) => (
                <li>
                    <div class="text-sm font-medium capitalize text-primary-soft">
                        {eventDateFormatter.format(event.data.date)}
                        {event.data.time && ` - ore ${event.data.time}`}
                    </div>
                    <div class="text-sm font-light text-muted-foreground">
                        {event.data.venue}, {event.data.city}
                    </div>
                </li>
            ))}
        </ul>
        <a href="/calendario" class="mt-5 inline-block border-b border-primary-soft pb-1 text-xs font-medium uppercase tracking-[0.16em] text-primary-soft transition-colors hover:border-foreground hover:text-foreground">
            Vedi il calendario
        </a>
    </div>
)}
