---
import { SOCIAL_LINKS } from "../../consts";
const year = new Date().getFullYear();
---

<footer
    class="bg-[#09090b] border-t border-white/10 mt-20 relative overflow-hidden"
>
    {/* Subtle top gradient */}
    <div
        class="absolute top-0 left-0 w-full h-px bg-[linear-gradient(to_right,transparent,rgba(37,99,235,0.4),transparent)]"
    >
    </div>

    <div class="container mx-auto px-4 py-16">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-8">
            {/* Brand & Description (Col span 5) */}
            <div class="md:col-span-12 lg:col-span-5 space-y-6">
                <div>
                    <h3
                        class="font-serif text-3xl font-bold text-foreground tracking-tight mb-3"
                    >
                        Sergio <span
                            class="text-transparent bg-clip-text bg-[linear-gradient(to_bottom,#2563eb,#1d4ed8)] italic pr-2"
                            >Procopio</span
                        >
                    </h3>
                    <p class="text-muted-foreground leading-relaxed max-w-sm">
                        L'arte del comico senza parole al servizio
                        dell'educazione e delle emozioni. Attore, mimo e regista
                        teatrale per scuole, parrocchie e piazze.
                    </p>
                </div>

                {/* Social Icons */}
                <div class="flex items-center space-x-4 pt-2">
                    <a
                        href={SOCIAL_LINKS.instagram}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-muted-foreground hover:bg-primary/20 hover:text-primary hover:border-primary/30 transition-all group"
                        aria-label="Instagram"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="group-hover:scale-110 transition-transform"
                            ><rect
                                width="20"
                                height="20"
                                x="2"
                                y="2"
                                rx="5"
                                ry="5"></rect><path
                                d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                            ></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"
                            ></line></svg
                        >
                    </a>
                    <a
                        href={SOCIAL_LINKS.facebook}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-muted-foreground hover:bg-primary/20 hover:text-primary hover:border-primary/30 transition-all group"
                        aria-label="Facebook"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="group-hover:scale-110 transition-transform"
                            ><path
                                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                            ></path></svg
                        >
                    </a>
                    <a
                        href={SOCIAL_LINKS.youtube}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-muted-foreground hover:bg-primary/20 hover:text-primary hover:border-primary/30 transition-all group"
                        aria-label="YouTube"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="group-hover:scale-110 transition-transform"
                            ><path
                                d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"
                            ></path><path d="m10 15 5-3-5-3z"></path></svg
                        >
                    </a>
                </div>
            </div>

            {/* Contact Info (Col span 4) */}
            <div class="md:col-span-6 lg:col-span-4 space-y-6">
                <h4
                    class="text-xs font-bold uppercase tracking-widest text-foreground/80"
                >
                    Contatti
                </h4>
                <ul class="space-y-4 text-sm text-muted-foreground">
                    <li>
                        <a
                            href="mailto:info@sergioprocopio.it"
                            class="hover:text-primary transition-colors flex items-center gap-3"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="text-primary/70 shrink-0"
                                ><path
                                    d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h8"
                                ></path><path
                                    d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                                ></path><path d="m16 19 2 2 4-4"></path></svg
                            >
                            info@sergioprocopio.it
                        </a>
                    </li>
                    <li>
                        <a
                            href="tel:+393805252684"
                            class="hover:text-primary transition-colors flex items-center gap-3"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="text-primary/70 shrink-0"
                                ><path
                                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                                ></path></svg
                            >
                            +39 3805252684
                        </a>
                    </li>
                </ul>
            </div>

            {/* Legal Info (Col span 3) */}
            <div class="md:col-span-6 lg:col-span-3 space-y-6">
                <h4
                    class="text-xs font-bold uppercase tracking-widest text-foreground/80"
                >
                    Dati Fiscali
                </h4>
                <div
                    class="space-y-4 text-sm text-muted-foreground bg-white/3 p-5 rounded-2xl border border-white/5 hover:border-white/10 transition-colors"
                >
                    <div class="flex items-start gap-3">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="text-primary/70 mt-1 shrink-0"
                            ><rect width="16" height="12" x="4" y="8" rx="2"
                            ></rect><path d="M2 14h2"></path><path d="M20 14h2"
                            ></path><path d="M15 13v2"></path><path d="M9 13v2"
                            ></path></svg
                        >
                        <div>
                            <span
                                class="block text-[10px] uppercase tracking-wider font-semibold text-foreground/60 mb-0.5"
                                >Partita IVA</span
                            >
                            <span>02470860137</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {/* Bottom Bar */}
        <div
            class="mt-16 pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4"
        >
            <div
                class="text-sm text-muted-foreground/60 flex flex-wrap items-center gap-x-2 gap-y-1"
            >
                <span
                    >&copy; {year} Sergio Procopio. Tutti i diritti riservati.</span
                >
            </div>

            <div class="flex items-center gap-6">
                <a
                    href="/privacy-policy"
                    class="text-sm text-muted-foreground/60 hover:text-primary transition-colors"
                >
                    Privacy Policy
                </a>
            </div>
        </div>
    </div>
</footer>
