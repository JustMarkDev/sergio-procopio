---
import { EnvelopeIcon, PhoneIcon } from "@heroicons/react/24/outline";
import { FacebookLogo, GithubLogo, InstagramLogo, YoutubeLogo } from "@phosphor-icons/react/dist/ssr";
import { SOCIAL_LINKS } from "../../consts";
const year = new Date().getFullYear();

const socials = [
    { name: "Instagram", href: SOCIAL_LINKS.instagram, Icon: InstagramLogo },
    { name: "Facebook", href: SOCIAL_LINKS.facebook, Icon: FacebookLogo },
    { name: "YouTube", href: SOCIAL_LINKS.youtube, Icon: YoutubeLogo },
    { name: "GitHub", href: SOCIAL_LINKS.github, Icon: GithubLogo },
];
const heading = "mb-3 text-[11px] font-medium uppercase tracking-[0.24em] text-foreground";
const link = "inline-flex min-h-10 items-center transition-colors hover:text-primary-soft";
---

<footer class="border-t border-border">
    <div class="container mx-auto px-4 py-16 md:px-8 lg:px-12">
        <div class="grid grid-cols-1 gap-12 text-sm font-light leading-relaxed text-muted-foreground md:grid-cols-12 lg:gap-8">
            <div class="md:col-span-7">
                <h3 class={heading}>Sergio Procopio</h3>
                <p class="max-w-sm">
                    L'arte del comico senza parole al servizio dell'educazione e delle emozioni.
                    Attore, mimo e regista teatrale per scuole, parrocchie e piazze.
                </p>
                <ul class="mt-4 flex flex-wrap gap-x-5">
                    {socials.map((social) => (
                        <li>
                            <a href={social.href} target="_blank" rel="noopener noreferrer" class={`${link} gap-2`}>
                                <social.Icon size={20} weight="regular" aria-hidden="true" />
                                {social.name}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>

            <div class="md:col-span-5">
                <h3 class={heading}>Contatti</h3>
                <ul>
                    <li>
                        <a href="mailto:info@sergioprocopio.it" class={`${link} gap-2`}>
                            <EnvelopeIcon className="size-5" aria-hidden="true" />
                            info@sergioprocopio.it
                        </a>
                    </li>
                    <li>
                        <a href="tel:+393805252684" class={`${link} gap-2`}>
                            <PhoneIcon className="size-5" aria-hidden="true" />
                            +39 3805252684
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="mt-16 flex flex-col items-start justify-between gap-2 border-t border-border pt-8 text-sm font-light text-muted-foreground md:flex-row md:items-center">
            <span>&copy; {year} Sergio Procopio. Tutti i diritti riservati.</span>
            <a href="/privacy" class={link}>Privacy</a>
        </div>
    </div>
</footer>
