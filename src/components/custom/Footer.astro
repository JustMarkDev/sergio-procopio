---
import { Mail, MapPin, Phone, ReceiptText } from "lucide-react";
import { SOCIAL_LINKS } from "../../consts";
const year = new Date().getFullYear();

// Stesse voci, stesso ordine della barra di navigazione (Header.tsx).
const pagine = [
    { name: "Home", href: "/" },
    { name: "Biografia", href: "/biografia" },
    { name: "Spettacoli", href: "/spettacoli" },
    { name: "Calendario", href: "/calendario" },
    { name: "Galleria", href: "/galleria" },
    { name: "Contatti", href: "/contatti" },
];
---

<footer
    class="bg-bar mt-8 relative overflow-hidden"
>

    <div class="container mx-auto px-4 md:px-8 lg:px-12 py-16">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-8">
            {/* Brand & Description (Col span 5) */}
            <div class="md:col-span-12 lg:col-span-5 space-y-6">
                <div>
                    <h3
                        class="font-serif text-3xl font-bold text-foreground tracking-tight mb-3"
                    >
                        Sergio <span
                            class="text-transparent bg-clip-text bg-[linear-gradient(to_bottom,#e8b44a,#c9a227)] italic pr-2"
                            >Procopio</span
                        >
                    </h3>
                    <p class="text-muted-foreground leading-relaxed max-w-sm">
                        L'arte del comico senza parole al servizio
                        dell'educazione e delle emozioni. Attore, mimo e regista
                        teatrale per scuole, parrocchie e piazze.
                    </p>
                </div>

                {/* Social Icons */}
                <div class="flex items-center space-x-4 pt-2">
                    <a
                        href={SOCIAL_LINKS.instagram}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group flex size-10 items-center justify-center rounded-full bg-white/5 text-muted-foreground shadow-[0_0_0_1px_rgba(255,255,255,0.1)] transition-[scale,color,background-color,box-shadow] duration-150 hover:bg-primary/20 hover:text-primary hover:shadow-[0_0_0_1px_rgba(212,162,76,0.35)] active:scale-[0.96]"
                        aria-label="Instagram"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="group-hover:scale-110 transition-transform"
                            ><rect
                                width="20"
                                height="20"
                                x="2"
                                y="2"
                                rx="5"
                                ry="5"></rect><path
                                d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                            ></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"
                            ></line></svg
                        >
                    </a>
                    <a
                        href={SOCIAL_LINKS.facebook}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group flex size-10 items-center justify-center rounded-full bg-white/5 text-muted-foreground shadow-[0_0_0_1px_rgba(255,255,255,0.1)] transition-[scale,color,background-color,box-shadow] duration-150 hover:bg-primary/20 hover:text-primary hover:shadow-[0_0_0_1px_rgba(212,162,76,0.35)] active:scale-[0.96]"
                        aria-label="Facebook"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="group-hover:scale-110 transition-transform"
                            ><path
                                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                            ></path></svg
                        >
                    </a>
                    <a
                        href={SOCIAL_LINKS.youtube}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group flex size-10 items-center justify-center rounded-full bg-white/5 text-muted-foreground shadow-[0_0_0_1px_rgba(255,255,255,0.1)] transition-[scale,color,background-color,box-shadow] duration-150 hover:bg-primary/20 hover:text-primary hover:shadow-[0_0_0_1px_rgba(212,162,76,0.35)] active:scale-[0.96]"
                        aria-label="YouTube"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="group-hover:scale-110 transition-transform"
                            ><path
                                d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"
                            ></path><path d="m10 15 5-3-5-3z"></path></svg
                        >
                    </a>
                </div>
            </div>

            {/* Pagine: stesse voci della barra di navigazione (Col span 3) */}
            <div class="md:col-span-6 lg:col-span-3 space-y-6">
                <h4
                    class="text-xs font-bold uppercase tracking-widest text-foreground/80"
                >
                    Pagine
                </h4>
                <ul class="space-y-2 text-base text-muted-foreground">
                    {
                        pagine.map((pagina) => (
                            <li>
                                <a
                                    href={pagina.href}
                                    class="flex min-h-10 items-center transition-colors hover:text-primary"
                                >
                                    {pagina.name}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            {/* Contatti e dati fiscali in un'unica colonna (Col span 4) */}
            <div class="md:col-span-6 lg:col-span-4 space-y-6">
                <h4
                    class="text-xs font-bold uppercase tracking-widest text-foreground/80"
                >
                    Contatti
                </h4>
                <div class="space-y-2 text-base text-muted-foreground">
                    <a
                        href="mailto:info@sergioprocopio.it"
                        class="flex min-h-10 items-center gap-3 transition-colors hover:text-primary"
                    >
                        <Mail
                            size={18}
                            aria-hidden="true"
                            className="text-primary/70 shrink-0"
                        />
                        info@sergioprocopio.it
                    </a>
                    <a
                        href="tel:+393805252684"
                        class="flex min-h-10 items-center gap-3 transition-colors hover:text-primary"
                    >
                        <Phone
                            size={18}
                            aria-hidden="true"
                            className="text-primary/70 shrink-0"
                        />
                        +39 380 5252684
                    </a>
                    <p class="flex min-h-10 items-center gap-3">
                        <ReceiptText
                            size={18}
                            aria-hidden="true"
                            className="text-primary/70 shrink-0"
                        />
                        P.IVA 02470860137
                    </p>
                    <p class="flex min-h-10 items-center gap-3">
                        <MapPin
                            size={18}
                            aria-hidden="true"
                            className="text-primary/70 shrink-0"
                        />
                        Via Genico, 2
                    </p>
                </div>
            </div>
        </div>

        {/* Bottom Bar */}
        <div
            class="mt-16 pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4"
        >
            <div
                class="text-sm text-muted-foreground/60 flex flex-wrap items-center gap-x-2 gap-y-1"
            >
                <span
                    >&copy; {year} Sergio Procopio. Tutti i diritti riservati.</span
                >
            </div>

            <div class="flex items-center gap-6">
                <a
                    href="/privacy-policy"
                    class="text-sm text-muted-foreground/60 hover:text-primary transition-colors"
                >
                    Privacy Policy
                </a>
            </div>
        </div>
    </div>
</footer>
