---
/**
 * TrePassi — sezione 8 della home, id="prenotare".
 *
 * Diaframma fra la home e la ContactForm esistente: dice esattamente cosa
 * mandare e cosa succede dopo, senza duplicare titolo e contenuti del modulo
 * che la segue.
 *
 * ZERO JAVASCRIPT PROPRIO. L'unica isola è <Reveal client:visible>, la
 * micro-isola condivisa che anima il blocco come un pezzo solo (fadeUp, EASE,
 * VIEWPORT, reduced motion gestito da useMotionSafe). Dentro, solo transizioni
 * CSS: hover sui recapiti e active:scale-[0.96].
 *
 * NOTA DI COPY (dallo spec, da non «migliorare» in autonomia): qui NON va
 * scritto alcun impegno sul tempo di risposta né alcuna fascia di prezzo,
 * perché non esistono nel materiale verificato. Se Sergio li conferma, il posto
 * è la riga immediatamente sotto il passo 02.
 */
import Reveal from "./Reveal";

/** Nessuna prop: il contenuto è interamente statico. */
export type Props = Record<string, never>;

interface Passo {
  /** Cifra decorativa, aria-hidden: l'ordine lo porta la <ol>. */
  numero: string;
  /** Reso in maiuscolo via CSS (`uppercase`), non scritto in maiuscolo nel dato. */
  titolo: string;
  testo: string;
}

const passi: Passo[] = [
  {
    numero: "01",
    titolo: "Scrivetemi",
    testo:
      "Bastano tre righe: una data indicativa, che spazio avete e che pubblico vi aspettate.",
  },
  {
    numero: "02",
    titolo: "Vi rispondo io",
    testo:
      "Vi propongo il titolo giusto per quella sala e per quell'età, con disponibilità, preventivo e scheda tecnica. Rispondo personalmente.",
  },
  {
    numero: "03",
    titolo: "Confermate",
    testo:
      "Alla produzione, all'audio e alle luci penso io. Voi aprite le porte e riempite la sala.",
  },
];

---

<section
  id="prenotare"
  aria-labelledby="prenotare-title"
  class="scroll-mt-28 bg-background-alt py-16 md:py-24"
>
  <div class="container mx-auto px-4 md:px-8 lg:px-12">
    <Reveal client:visible>
      <h2
        id="prenotare-title"
        class="mx-auto max-w-3xl text-center font-serif text-[clamp(2rem,4.2vw,3.5rem)] leading-[1.03] font-bold tracking-tight text-foreground"
      >
        Tre passi, e la data è vostra.
      </h2>

      <ol
        role="list"
        class="mt-12 grid gap-10 md:mt-16 md:grid-cols-3"
        style="--passo-num: clamp(3rem, 6vw, 4.5rem);"
      >
        {
          passi.map((passo) => (
            <li class="relative">
              <span
                aria-hidden="true"
                class="block font-serif text-[length:var(--passo-num)] leading-none font-bold tabular-nums text-primary/20"
              >
                {passo.numero}
              </span>
              <h3 class="mt-4 font-sans text-sm font-bold tracking-[0.22em] text-primary uppercase">
                {passo.titolo}
              </h3>
              <p class="mt-3 text-base leading-relaxed text-muted-foreground">
                {passo.testo}
              </p>
            </li>
          ))
        }
      </ol>

      {/*
        DIAFRAMMA VERSO I CONTATTI — ultimo elemento della sezione.
        Sta qui dentro e non come contenitore attorno a ContactForm, che ha
        sfondi in position:absolute e un glow radiale che verrebbero ritagliati.
      */}
      <div
        aria-hidden="true"
        class="mx-auto mt-16 h-0.5 w-48 rounded-full bg-linear-to-r from-transparent via-primary to-transparent shadow-[0_0_18px_rgba(212,162,76,0.45)] md:mt-20 md:w-64"
      >
      </div>
    </Reveal>
  </div>
</section>
