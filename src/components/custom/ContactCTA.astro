---
import { Image } from "astro:assets";
import ctaImage from "../../assets/spettacoli/la-valigia-di-s-francesco/la ricerca.webp";
---

<section id="contatti" aria-labelledby="contact-cta-title" class="relative scroll-mt-16 overflow-hidden py-24 lg:py-36">
    <div class="pointer-events-none absolute inset-y-0 right-0 w-full opacity-70 mask-[linear-gradient(to_right,transparent,black_50%)] lg:w-4/5" aria-hidden="true">
        <Image
            src={ctaImage}
            alt=""
            widths={[640, 1000, 1500]}
            sizes="(min-width: 1024px) 80vw, 100vw"
            format="webp"
            quality={75}
            loading="lazy"
            class="h-full w-full object-cover"
        />
    </div>
    <div class="pointer-events-none absolute inset-0 bg-background/55 lg:bg-transparent bg-[linear-gradient(to_top,var(--background),transparent_30%),linear-gradient(to_bottom,var(--background),transparent_30%)]"></div>

    <div class="container relative mx-auto px-4 md:px-8 lg:px-12">
        <h2 id="contact-cta-title" class="max-w-[13em] text-[clamp(1.75rem,5.2vw,4.75rem)] uppercase leading-[1.04]">
            Porta lo spettacolo nella tua scuola, parrocchia o teatro.
        </h2>
        <p class="mt-6 max-w-[36ch] text-base font-light leading-relaxed text-foreground/85 lg:text-lg">
            Indica data e luogo: riceverai una proposta adatta al tuo pubblico.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-3">
            <a href="/contatti" class="inline-flex min-h-12 items-center justify-center whitespace-nowrap border border-primary bg-primary px-7 text-xs font-medium uppercase tracking-[0.18em] text-primary-foreground transition-[background-color,border-color,scale] hover:border-primary-hover hover:bg-primary-hover active:scale-[0.98]">
                Richiedi una data
            </a>
            <a href="tel:+393805252684" class="inline-flex min-h-11 items-center text-sm font-light text-foreground/85 transition-colors hover:text-primary-soft">
                Oppure chiama il 380 5252684
            </a>
        </div>
    </div>
</section>
