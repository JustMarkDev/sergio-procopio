---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getEntry, render } from "astro:content";
import profile from "../../../photoshoot/MyPhoto_070.webp";
import suit from "../../../photoshoot/MyPhoto_147.webp";
import eyes from "../../../photoshoot/MyPhoto_161.webp";
import doorway from "../../../photoshoot/MyPhoto_113.webp";

interface Props {
    canonicalPath?: string;
    heading?: string;
}

const { canonicalPath = "/biografia", heading } = Astro.props;
const biografia = await getEntry("pages", "biografia");

if (!biografia) {
    throw new Error("Biografia content entry not found.");
}

const pageHeading = heading ?? biografia.data.title;
const { Content } = await render(biografia);
const photoshoot = [profile, suit, eyes, doorway];
---

<Layout
    title={`${pageHeading} | Sergio Procopio`}
    description={biografia.data.description}
    canonicalPath={canonicalPath}
>
    <div class="container mx-auto px-4 pb-24 pt-36 md:px-8 lg:px-12">
        <header class="mb-24 flex flex-col items-center gap-12 lg:flex-row lg:gap-16">
            <div class="space-y-8 lg:w-1/2">
                <h1 class="text-[clamp(2.75rem,8vw,7rem)] uppercase leading-[0.92]">{pageHeading}</h1>
                {
                    biografia.data.quote && (
                        <p class="max-w-xl border-l-2 border-primary-soft/50 pl-6 text-xl font-light leading-relaxed text-foreground/85 md:text-2xl">
                            "{biografia.data.quote}"
                        </p>
                    )
                }
            </div>

            {
                biografia.data.image && (
                    <div class="relative aspect-4/5 w-full lg:w-1/2 mask-[radial-gradient(closest-side_at_50%_50%,black_50%,transparent_100%)]">
                        <Image
                            src={biografia.data.image}
                            alt="Ritratto di Sergio Procopio"
                            loading="eager"
                            class="absolute inset-0 h-full w-full object-cover"
                        />
                    </div>
                )
            }
        </header>

        <div class="mb-24 grid grid-cols-2 gap-0.5 md:grid-cols-4">
            {photoshoot.map((photo) => (
                <Image
                    src={photo}
                    alt=""
                    widths={[400, 640]}
                    sizes="(min-width: 768px) 25vw, 50vw"
                    format="webp"
                    quality={75}
                    loading="lazy"
                    class="aspect-2/3 w-full object-cover"
                />
            ))}
        </div>

        <div class="richtext">
            <Content />
        </div>
    </div>
</Layout>
