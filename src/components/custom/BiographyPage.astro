---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getEntry, render } from "astro:content";

interface Props {
    canonicalPath?: string;
    heading?: string;
}

const { canonicalPath = "/biografia", heading } = Astro.props;
const biografia = await getEntry("pages", "biografia");

if (!biografia) {
    throw new Error("Biografia content entry not found.");
}

const pageHeading = heading ?? biografia.data.title;
const { Content } = await render(biografia);

const { since, stats } = biografia.data;
const figures = [
    ...(since ? [{ value: String(new Date().getFullYear() - since), label: "Anni sul palco" }] : []),
    ...stats,
];
---

<Layout
    title={`${pageHeading} | Sergio Procopio`}
    description={biografia.data.description}
    canonicalPath={canonicalPath}
>
    <section class="relative flex min-h-[min(800px,100svh)] items-end overflow-hidden pb-14 lg:pb-20">
        {
            biografia.data.image && (
                <div class="pointer-events-none absolute right-0 top-0 h-full w-full mask-[linear-gradient(to_right,transparent,black_35%)] lg:w-[70%]" aria-hidden="true">
                    <Image
                        src={biografia.data.image}
                        alt=""
                        widths={[640, 1000, 1400]}
                        sizes="(min-width: 1024px) 70vw, 100vw"
                        loading="eager"
                        fetchpriority="high"
                        class="h-full w-full object-cover object-[50%_20%] outline-none"
                    />
                </div>
            )
        }
        <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_top,var(--background)_0%,transparent_46%),linear-gradient(to_bottom,var(--background)_0%,transparent_22%)]"></div>

        <div class="container relative mx-auto px-4 md:px-8 lg:px-12">
            <h1 class="text-[clamp(2.75rem,9vw,8.75rem)] uppercase leading-[0.9]">{pageHeading}</h1>
            {
                biografia.data.quote && (
                    <p class="mt-8 max-w-xl border-l-2 border-primary-soft/50 pl-6 text-xl font-light leading-relaxed text-foreground/85 md:text-2xl">
                        "{biografia.data.quote}"
                    </p>
                )
            }
        </div>
    </section>

    <div class="container mx-auto px-4 pb-24 md:px-8 lg:px-12">
        {
            figures.length > 0 && (
                <dl class="grid grid-cols-2 border-y border-border max-md:[&>:last-child:nth-child(odd)]:col-span-2 md:grid-cols-3 lg:grid-cols-5">
                    {figures.map((item) => (
                        <div class="flex flex-col-reverse justify-end gap-2 px-1 py-8 lg:px-6 lg:first:pl-0">
                            <dt class="text-[11px] uppercase tracking-[0.2em] text-muted-foreground">{item.label}</dt>
                            <dd class="text-[clamp(2.5rem,5vw,4.25rem)] uppercase leading-none text-foreground">{item.value}</dd>
                        </div>
                    ))}
                </dl>
            )
        }

        <div class="richtext bio mt-16 lg:mt-24">
            <Content />
        </div>
    </div>
</Layout>
