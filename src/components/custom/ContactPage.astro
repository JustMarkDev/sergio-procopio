---
import Layout from "../../layouts/Layout.astro";
import ContactForm from "./ContactForm";
import ContactHeading from "./ContactHeading";
import { CONTACT_NAP } from "../../lib/contact-trust";

interface Props {
    locale: "it" | "en";
}

const { locale } = Astro.props;
const isEnglish = locale === "en";
const canonicalPath = isEnglish
    ? CONTACT_NAP.contactAliasPath
    : CONTACT_NAP.contactPath;
const title = isEnglish
    ? "Contact | Sergio Procopio"
    : "Contatti | Sergio Procopio";
const description = isEnglish
    ? "Contact Sergio Procopio for theatre shows, workshops and educational meetings. Phone, email and booking steps."
    : "Contatta Sergio Procopio per spettacoli, laboratori e incontri formativi. Racconta il tuo evento o chiama per parlare della prossima data.";
const stepsTitle = isEnglish ? "How we organise" : "Come ci organizziamo";
const steps = isEnglish
    ? [
          {
              title: "Write to me",
              description:
                  "Tell me the period, the venue and the audience you want to involve.",
          },
          {
              title: "I reply",
              description:
                  "We check availability and define a proposal with a quote.",
          },
          {
              title: "We confirm the date",
              description:
                  "We agree the technical details so the show can come to you.",
          },
      ]
    : [
          {
              title: "Scrivimi",
              description:
                  "Raccontami il periodo, il luogo e il pubblico che vorresti coinvolgere.",
          },
          {
              title: "Ti rispondo io",
              description:
                  "Verifichiamo la disponibilità e definiamo una proposta con un preventivo.",
          },
          {
              title: "Confermiamo la data",
              description:
                  "Accordiamo i dettagli tecnici per portare lo spettacolo da te.",
          },
      ];
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
    <div
        class="container mx-auto grid grid-cols-1 gap-10 px-4 pb-24 pt-36 md:px-8 lg:grid-cols-[0.85fr_1.15fr] lg:grid-rows-[auto_1fr] lg:gap-x-16 lg:gap-y-12 lg:px-12"
    >
        <section
            class="lg:col-start-1 lg:row-start-1"
            aria-labelledby="contact-page-heading"
        >
            {
                isEnglish ? (
                    <h1
                        id="contact-page-heading"
                        class="text-[clamp(1.75rem,6vw,2.75rem)] uppercase leading-[1.08]"
                    >
                        Contact Sergio Procopio
                    </h1>
                ) : (
                    <div id="contact-page-heading">
                        <ContactHeading client:load />
                    </div>
                )
            }
            <p class="mt-5 max-w-md text-base font-light leading-relaxed text-foreground/85">
                {
                    isEnglish
                        ? "Shows, workshops and meetings: tell me what you have in mind for your audience. This is the official Contact page for availability, quotes and dates."
                        : "Spettacoli, laboratori e incontri: raccontami cosa hai in mente per il tuo pubblico. Questa è la pagina ufficiale per chiedere disponibilità, un preventivo o una data per scuole, parrocchie, associazioni, comuni, teatri e famiglie."
                }
            </p>
            <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
                <a
                    href={`tel:${CONTACT_NAP.telephone}`}
                    class="inline-flex min-h-12 items-center justify-center whitespace-nowrap border border-foreground/40 px-6 text-xs font-medium uppercase tracking-[0.18em] transition-colors hover:border-foreground"
                >
                    {isEnglish ? "Call now" : "Chiama ora"}
                </a>
                <a
                    href={`mailto:${CONTACT_NAP.email}`}
                    class="text-sm font-light text-foreground/85 underline underline-offset-4 transition-colors hover:text-primary-soft"
                >
                    {CONTACT_NAP.email}
                </a>
            </div>
        </section>

        <div
            class="min-w-0 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:[&>astro-island]:h-full"
        >
            <ContactForm client:load />
        </div>

        <section
            aria-labelledby="contact-steps-title"
            class="lg:col-start-1 lg:row-start-2"
        >
            <h2
                id="contact-steps-title"
                class="mb-2 text-xs font-medium uppercase tracking-[0.24em] text-primary-soft"
            >
                {stepsTitle}
            </h2>
            <ol class="divide-y divide-border" role="list">
                {
                    steps.map((step, index) => (
                        <li class="grid grid-cols-[2rem_1fr] gap-3 py-4">
                            <span
                                aria-hidden="true"
                                class="pt-0.5 text-sm tabular-nums text-muted-foreground"
                            >
                                {String(index + 1).padStart(2, "0")}
                            </span>
                            <div>
                                <h3 class="text-base font-medium">
                                    {step.title}
                                </h3>
                                <p class="mt-1 text-sm font-light leading-6 text-muted-foreground">
                                    {step.description}
                                </p>
                            </div>
                        </li>
                    ))
                }
            </ol>
        </section>
    </div>
</Layout>
