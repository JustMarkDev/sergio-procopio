---
import Layout from "../../layouts/Layout.astro";
import ContactForm from "./ContactForm";
import ContactHeading from "./ContactHeading";
import { CONTACT_NAP, CONTACT_STEPS } from "../../lib/contact-trust";

interface Props {
    locale: "it" | "en";
}

const { locale } = Astro.props;
const isEnglish = locale === "en";
const canonicalPath = isEnglish
    ? CONTACT_NAP.contactAliasPath
    : CONTACT_NAP.contactPath;
const title = isEnglish
    ? "Contact | Sergio Procopio"
    : "Contatti | Sergio Procopio";
const description = isEnglish
    ? "Contact Sergio Procopio for theatre shows, workshops and educational meetings. Phone, email and booking steps."
    : "Contatta Sergio Procopio per spettacoli, laboratori e incontri formativi. Racconta il tuo evento o chiama per parlare della prossima data.";
const stepsTitle = isEnglish ? "How we organise" : "Come ci organizziamo";
const steps = CONTACT_STEPS[locale];
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
    <div
        class="container mx-auto grid grid-cols-1 gap-12 px-4 pb-24 pt-36 md:px-8 lg:min-h-svh lg:grid-cols-[0.85fr_1.15fr] lg:content-center lg:gap-x-12 lg:px-12 lg:pb-6 lg:pt-28"
    >
        <div class="flex flex-col justify-between gap-8">
            <header aria-labelledby="contact-page-heading">
                {
                    isEnglish ? (
                        <h1
                            id="contact-page-heading"
                            class="text-[clamp(1.5rem,3vw,2.9rem)] uppercase leading-[0.98]"
                        >
                            Contact Sergio Procopio
                        </h1>
                    ) : (
                        <div id="contact-page-heading">
                            <ContactHeading client:load />
                        </div>
                    )
                }
                <p class="mt-4 max-w-lg text-base font-light leading-relaxed text-foreground/85">
                    {
                        isEnglish
                            ? "Shows, workshops and meetings: tell me what you have in mind for your audience. This is the official Contact page for availability, quotes and dates."
                            : "Spettacoli, laboratori e incontri: raccontami cosa hai in mente per il tuo pubblico. Questa è la pagina ufficiale per chiedere disponibilità, un preventivo o una data per scuole, parrocchie, associazioni, comuni, teatri e famiglie."
                    }
                </p>
                <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-4">
                    <a
                        href={`tel:${CONTACT_NAP.telephone}`}
                        class="inline-flex min-h-12 items-center justify-center whitespace-nowrap bg-primary px-7 text-xs font-medium uppercase tracking-[0.18em] text-primary-foreground transition-[background-color,scale] hover:bg-primary-hover active:scale-[0.98]"
                    >
                        {isEnglish ? "Call now" : "Chiama ora"}
                    </a>
                    <a
                        href={`mailto:${CONTACT_NAP.email}`}
                        class="text-base font-light text-foreground/85 underline underline-offset-4 transition-colors hover:text-primary-soft"
                    >
                        {CONTACT_NAP.email}
                    </a>
                </div>
            </header>

            <section
                aria-labelledby="contact-steps-title"
                class="border-t border-border pt-5"
            >
                <h2
                    id="contact-steps-title"
                    class="mb-2 text-xs font-medium uppercase tracking-[0.24em] text-primary-soft"
                >
                    {stepsTitle}
                </h2>
                <ol class="divide-y divide-border" role="list">
                    {
                        steps.map((step, index) => (
                            <li class="grid grid-cols-[2.5rem_1fr] gap-3 py-2.5">
                                <span
                                    aria-hidden="true"
                                    class="pt-0.5 text-sm tabular-nums text-muted-foreground"
                                >
                                    {String(index + 1).padStart(2, "0")}
                                </span>
                                <div>
                                    <h3 class="text-base">{step.title}</h3>
                                    <p class="mt-0.5 text-sm font-light leading-5 text-muted-foreground">
                                        {step.description}
                                    </p>
                                </div>
                            </li>
                        ))
                    }
                </ol>
            </section>
        </div>

        <div class="min-w-0 lg:[&>astro-island]:h-full">
            <ContactForm client:load />
        </div>
    </div>
</Layout>
