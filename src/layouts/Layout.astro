---
import '@fontsource/inter';
import '@fontsource/playfair-display';
import '../styles/globals.css';
import SEO from '../components/SEO.astro';
import Schema from '../components/Schema.astro';
import Header from '../components/custom/Header';
import Footer from '../components/custom/Footer.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;
---

<!doctype html>
<html lang="it" class="dark scroll-smooth">
	<head>
		<SEO title={title} description={description} canonicalPath={canonicalPath} />
		<Schema />
		<ClientRouter />
		{/* Le isole animate sono servite con opacity:0 e vengono rivelate
		    dall'animazione d'entrata. Senza JavaScript resterebbero invisibili
		    e la pagina apparirebbe vuota: qui le si forza visibili. */}
		<noscript>
			<style>
				[style*="opacity:0"],
				[style*="opacity: 0"] {
					opacity: 1 !important;
					transform: none !important;
				}
			</style>
		</noscript>
	</head>
	<body>
		<Header client:load transition:persist />
		<main>
			<slot />
		</main>
		<Footer />
		<SpeedInsights />
		<Analytics />
	</body>
</html>
